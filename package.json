{
  "name": "Linkjob",
  "version": "2.0.0",
  "description": "Linkjob",
  "author": "Linkjob",
  "packageManager": "yarn@1.22.19",
  "license": "UNLICENSED",
  "scripts": {
    "sync-public": "rclone copy ./public r2:public --config ./rclone.conf --checksum --verbose --metadata-set cache-control=public,max-age=31536000,immutable",
    "predev": "node scripts/sync-public.mjs",
    "prebuild": "node scripts/sync-public.mjs",
    "dev": "ASTRO_BASE=/ node --max-old-space-size=8192 ./node_modules/.bin/astro dev",
    "build": "ASTRO_BASE=/ node --max-old-space-size=8192 ./node_modules/.bin/astro build",
    "postbuild": "node scripts/postbuild-sitemap.mjs",
    "preview": "node --max-old-space-size=8192 ./node_modules/.bin/astro preview",
    "test:account": "node --test scripts/account-nav-dropdown.test.mjs scripts/account-auth.test.mjs",
    "format": "prettier -w ./src"
  },
  "dependencies": {
    "@astrojs/db": "^0.18.3",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/react": "^4.4.2",
    "@astrojs/rss": "^4.0.14",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/tailwind": "^6.0.2",
    "@emailjs/browser": "^4.4.1",
    "@types/nodemailer": "^6.4.17",
    "aos": "^2.3.4",
    "astro": "^5.16.6",
    "astro-auto-import": "^0.4.4",
    "astro-font": "^0.1.81",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.1.0",
    "disqus-react": "^1.1.5",
    "fast-xml-parser": "^5.2.5",
    "fs-extra": "^11.2.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^14.1.3",
    "nodemailer": "^6.10.0",
    "path": "^0.12.7",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-compiler-runtime": "^19.0.0-beta-63e3235-20250105",
    "react-countup": "^6.5.3",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-intersection-observer": "^9.13.1",
    "react-lite-youtube-embed": "^2.4.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "shiki": "^2.0.3",
    "simple-git": "^3.27.0",
    "swiper": "^11.1.14"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@types/aos": "^3.0.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/marked": "^5.0.2",
    "@types/node": "22.8.7",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.11",
    "eslint": "^9.14.0",
    "postcss": "^8.5.1",
    "postcss-nested": "^7.0.2",
    "postcss-preset-env": "^10.1.3",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "sass": "^1.80.6",
    "sharp": "0.33.5",
    "tailwind-bootstrap-grid": "^5.1.0",
    "tailwindcss": "^3.4.14",
    "tailwindcss-gradient": "^1.1.0",
    "typescript": "5.6.3"
  }
}
