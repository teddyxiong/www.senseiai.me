import HeroCapabilitySwitcher from "@/partials/HeroCapabilitySwitcher.astro";
import FeaturesInterviewCopilot from "@/partials/FeaturesInterviewCopilot.astro";
import videos from "@/config/video.json";
import "../styles/home-video-dialog.css";

const interviewCopilotPageData = await getEntry("interview-copilot", "-index");
if (!interviewCopilotPageData) {
  throw new Error("interview-copilot page data not found");
}
const {
  banner,
  challenges_section,
  platform,
  explore_section,
  inbound_solution,
  tools_section,
  nav_buttons: navButtons = [],
} = interviewCopilotPageData.data;

const testimonial = await getEntry("sections", "testimonial");
if (!testimonial) {
  throw new Error("testimonial data not found");
}

const testimonialCopy = (await getEntry(
  "sections",
  "testimonialinterviewcopilot",
)) as unknown as { data: { title: string; description: string } };
if (!testimonialCopy?.data) {
  throw new Error("testimonialinterviewcopilot data not found");
}
const testimonialCopyTitle = testimonialCopy.data.title as string;
const testimonialCopyDescription = testimonialCopy.data.description as string;

const faqEntry = await getEntry("sections", "faqinterviewcopilot");
if (!faqEntry) {
  throw new Error("faqinterviewcopilot data not found");
}

const ctaEntry = await getEntry("sections", "call-to-action-copilot");
if (!ctaEntry) {
  throw new Error("call-to-action-copilot data not found");
}

const video = videos.codingInterviewCopilot;
