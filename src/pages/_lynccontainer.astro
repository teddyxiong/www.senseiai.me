---
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import PageHeader from "@/partials/PageHeader.astro";
import { getEntry } from "astro:content";
import Notice from "@/shortcodes/Notice";

const lynccontainerIndex = await getEntry("lynccontainer", "-index");
if (!lynccontainerIndex) {
  throw new Error("lynccontainer data not found");
}
const {
  meta_title,
  meta_description,
  title,
  description,
  last_updated,
  current_version,
  items,
} = lynccontainerIndex.data;

---

<Base title={meta_title} description={meta_description}>
  <PageHeader title={title} />
  
  <!-- Downloads Section -->
  <section class="section py-0 mt-0 mb-0">
    <div class="container">
      <div class="row gy-4">
        <div class="mx-auto text-center lg:col-12">
          <div
            class="section-heading-shape"
            aria-label="shape"
            data-aos="fade-up-sm"
          >
          </div> 
           <h2
            class="mb-6"
            data-aos="fade-up-sm"
            data-aos-delay="50"
            set:html={markdownify(description || "")}
          />
          
          
          <!-- Version Info -->
          <!-- <div class="mb-12 flex flex-wrap justify-center gap-6 text-sm text-gray-600">
            {current_version && (
              <div class="flex items-center gap-2">
                <span class="font-semibold">Current Version:</span>
                <span class="rounded-full bg-primary/10 px-3 py-1 text-primary">{current_version}</span>
              </div>
            )}
            {last_updated && (
              <div class="flex items-center gap-2">
                <span class="font-semibold">Last Updated:</span>
                <span>{last_updated}</span>
              </div>
            )}
          </div> -->
        </div>

        <!-- Download Cards -->
        <div class="col-12">
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {items.map((item: any, index: number) => (
              <div
                class="group relative overflow-hidden rounded-xl border-2 border-purple-200 bg-white p-6 shadow-sm transition-all duration-300 hover:border-primary hover:shadow-lg"
                // data-aos="fade-up-sm"
                // data-aos-delay={150 + index * 50}
              >
                <!-- Platform Icon -->
                <div class="mb-4 flex justify-center">
                  <div class="flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-br from-primary/10 to-primary/5">
                    <img
                      src={item.image}
                      alt={item.name}
                      class="h-8 w-8 object-contain"
                    />
                  </div>
                </div>
                
                <!-- Platform Info -->
                <div class="text-center">
                  <h3 class="mb-2 text-lg font-semibold text-dark">{item.name}</h3>
                  <p class="mb-4 text-sm text-gray-600">{item.description}</p>
                  <div class="mb-4 text-xs text-gray-500">
                    <span class="font-medium">Size:</span> {item.file_size}
                  </div>
                </div>
                
                <!-- Download Button -->
                <div class="text-center">
                  <a
                    href={item.url}
                    class="btn btn-primary btn-sm w-full transition-all duration-300 group-hover:bg-primary group-hover:text-white download-btn"
                    download
                  >
                    Download
                  </a>
                </div>
                
                <!-- Hover Effect -->
                <div class="absolute inset-0 -z-10 bg-gradient-to-br from-primary/5 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
              </div>
            ))}
          </div>
        </div>
        
        <!-- {description && (
            <p
              class="mb-8 text-lg"
              // data-aos="fade-up-sm"
              // data-aos-delay="100"
              set:html={markdownify(description)}
            />
          )} -->
          
        <!-- Additional Info -->
        <!-- <div class="col-12">
          <div class="mx-auto mt-12 max-w-4xl text-center">
            <div class="rounded-lg bg-gray-50 p-6">
              <h3 class="mb-4 text-lg font-semibold">System Requirements</h3>
              <div class="grid grid-cols-1 gap-4 text-sm text-gray-600 md:grid-cols-2 lg:grid-cols-3">
                <div>
                  <strong>Mac Intel:</strong><br>
                  macOS 10.14 or later
                </div>
                <div>
                  <strong>Mac Apple Silicon:</strong><br>
                  macOS 11.0 or later
                </div>
                <div>
                  <strong>Windows:</strong><br>
                  Windows 10/11 (64-bit)
                </div>
                <div>
                  <strong>Linux:</strong><br>
                  Ubuntu 18.04+ or equivalent
                </div>
            </div>
          </div>
        </div> -->
      </div>
    </div>
  </section>
  <!-- /.Downloads Section -->

  <!-- Trial Code Modal -->
  <div id="trialCodeModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black bg-opacity-50 backdrop-blur-sm">
    <div class="relative mx-4 w-full max-w-2xl min-h-[400px] rounded-lg bg-white p-10 shadow-xl">
      <!-- Close Button -->
      <button
        id="closeTrialModal"
        class="absolute right-4 top-4 text-gray-400 hover:text-gray-600 transition-colors"
        aria-label="Close modal"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Loading State -->
      <div id="loadingState" class="text-center">
        <div class="mb-4 flex justify-center">
          <div class="h-12 w-12 animate-spin rounded-full border-4 border-primary border-t-transparent"></div>
        </div>
        <h3 class="mb-2 text-lg font-semibold text-dark">Requesting Free Trial License</h3>
        <p class="text-sm text-gray-600">Please wait, generating your Free Trial License...</p>
      </div>

      <!-- Success State -->
      <div id="successState" class="hidden text-center">
        <div class="mb-4 flex justify-center">
          <div class="flex h-12 w-12 items-center justify-center rounded-full" style="background-color: #393294;">
            <svg class="h-6 w-6" fill="none" stroke="#FFF" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
        </div>
        <h3 class="mb-4 text-lg font-semibold text-dark">Request Successful</h3>
        
        <!-- License Key Display -->
        <div class="mb-10">
          <label class="mb-2 block text-sm font-medium text-gray-700">Free Trial License</label>
          <div class="relative">
            <input
              id="licenseKeyInput"
              type="text"
              readonly
              class="w-full rounded-md border border-gray-300 bg-gray-50 px-3 py-2 text-sm font-mono text-center focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
              placeholder="Generating..."
            />
            <button
              id="copyLicenseKey"
              class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-primary transition-colors"
              title="Copy License"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Success Message -->
        <div class="mb-4 rounded-md p-3  mt-15" style="background-color: #393294;">
          <p class="text-sm text-white">
            <strong>Free Trial License copied!</strong> 
          </p>
          <p class="text-sm text-white">
            Please paste it after software installation to experience all features of Linkjob AI.
          </p>
        </div>

        <!-- Expiry Notice -->
        <p class="text-large mt-10 text-left" style="color: #393294;">Each Free Trial License is valid for 10 minutes.You may see a warning during download that senseiai.me is unverified. This is because our software ensures full invisibility during screen sharing by modifying system settings. Rest assured, it's 100% safe.</p>
      </div>

      <!-- Error State -->
      <div id="errorState" class="hidden text-center">
        <div class="mb-4 flex justify-center">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-red-100">
            <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
            </svg>
          </div>
        </div>
        <h3 class="mb-4 text-lg font-semibold text-dark">Request Failed</h3>
        <p class="mb-4 text-sm text-gray-600">Unable to obtain Free Trial License, please contact administrator for assistance.</p>
        
        <!-- Discord Link -->
        <a
          href="https://discord.com/invite/PfrcRpt7Sv"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 mt-10 rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 transition-colors"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418z"></path>
          </svg>
          <span>Join Discord</span>
        </a>
      </div>

      <!-- Close modal containers -->
    </div>
  </div>

  <!-- Tutorial Videos -->
  <section class="section py-0 mt-20">
    <div class="container">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 mt-6 mb-16">
        <!-- Mac Installation Video -->
        <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
          <h3 class="mb-6 text-base font-semibold text-dark text-center">Mac Installation Guide</h3>
          <div class="aspect-video w-full overflow-hidden rounded-lg">
            <iframe
              src="https://www.youtube.com/embed/IFrDfVROu_4?si=FzvpkJDznwcOTBDI"
              title="Mac Installation Video"
              class="h-full w-full"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>

          <div class="mt-4">
            <Notice type="tip">Apple could not verify LinkjobAI ? Just follow these steps:<br />
              - Go to <strong>System Settings</strong>.<br />
              - Click on <strong>Privacy & Security</strong>.<br />
              - Scroll down to the <strong>Security</strong> section.<br />
              - You will see "Linkjob AI" listed there. Click the <strong>Open Anyway</strong> button next to it.<br />
            </Notice>
          </div>
          <div class="mt-4">
            <Notice type="tip">LinkjobAI is damaged? Just follow these steps:<br />
              - Open the <strong> Terminal </strong>application.<br />
              - Paste this code:  <br /><strong>xattr -cr /Applications/LinkjobAI.app && open /Applications/LinkjobAI.app</strong><br />
              - Press <strong>Enter</strong> to run it.<br />
              - You will see "Linkjob AI" listed there. Click the <strong>Open Anyway</strong> button next to it.<br />
            </Notice>
          </div>
          
           

            <div class="mt-4 rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
              <div id="copyMacArea" class="flex items-center justify-between gap-3 cursor-pointer" role="button" tabindex="0" aria-label="Click to copy command">
                <pre class="font-mono text-sm p-3 bg-black text-white rounded-md overflow-x-auto m-0"><code>xattr -cr /Applications/LinkjobAI.app  && open  /Applications/LinkjobAI.app</code></pre>
              </div>
              <p id="copyMacMsg" class="mt-2 text-xs text-gray-500 hidden">Copied!</p>
            </div>
            <div class="mt-4">
              <img src="/images/macteminal.png" alt="Windows Defender SmartScreen prompt" class="mx-auto rounded-lg border border-gray-200 shadow-sm max-w-full" />
            </div>
            <script>
              document.addEventListener('DOMContentLoaded', function() {
                const copyArea = document.getElementById('copyMacArea');
                const msg = document.getElementById('copyMacMsg');
                const cmdText = 'xattr -cr /Applications/LinkjobAI.app  && open /Applications/LinkjobAI.app';

                const copyHandler = async () => {
                  try {
                    await navigator.clipboard.writeText(cmdText);
                    if (msg) {
                      msg.textContent = 'Copied!';
                      msg.classList.remove('hidden');
                      setTimeout(() => msg.classList.add('hidden'), 1500);
                    }
                  } catch (e) {
                    if (msg) {
                      msg.textContent = 'Copy failed';
                      msg.classList.remove('hidden');
                      setTimeout(() => msg.classList.add('hidden'), 2000);
                    }
                  }
                };

                if (copyArea) {
                  copyArea.addEventListener('click', copyHandler);
                  copyArea.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' || e.key === ' ') {
                      e.preventDefault();
                      copyHandler();
                    }
                  });
                }
              });
            </script>
           
          

        </div>
        <!-- Windows Installation Video -->
        <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
          <h3 class="mb-6 text-base font-semibold text-dark text-center">Windows Installation Guide</h3>
          <div class="aspect-video w-full overflow-hidden rounded-lg">
            <iframe
              src="https://www.youtube.com/embed/YnaAnNmLsas?si=OLnOHaCIM13B_qwg"
              title="Windows Installation Video"
              class="h-full w-full"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
           <div class="mt-4">
            <Notice type="tip">What should I do when Windows prompts Microsoft Defender SmartScreen prevented an unrecognised app from starting or this software is not certified?<br /><br />
               <strong> Please be assured that our software is completely safe. </strong><br /><br />
              - When you see a security prompt, it's simply because our app has been customized to run discreetly in the background, which sometimes triggers a standard security warning.<br />
              - You just need to click  <strong>Keep/Run Anyway</strong> to to finish your download.<br />
            </Notice>

            <div class="mt-4">
              <img src="/images/windowsdefender.png" alt="Windows Defender SmartScreen prompt" class="mx-auto rounded-lg border border-gray-200 shadow-sm max-w-full" />
            </div>
            
          </div>
        </div>
        
      </div>
    </div>
  </section>

  <!-- <CallToAction /> -->
</Base>
            
