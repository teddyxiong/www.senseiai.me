---
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import PageHeader from "@/partials/PageHeader.astro";
import DownloadButton from "@/components/DownloadButton.astro";
import { getEntry } from "astro:content";
import Notice from "@/shortcodes/Notice";

const downloadsIndex = await getEntry("downloads", "-index");
if (!downloadsIndex) {
  throw new Error("Downloads data not found");
}

const { 
  meta_title, 
  meta_description, 
  title, 
  description, 
  items,
  size_label,
  download_icon,
  check_icon,
  windows_guide,
} = downloadsIndex.data;

const macIntel = items.find((item: any) =>
  String(item?.name ?? "").toLowerCase().includes("intel")
);

const macSilicon = items.find((item: any) =>
  String(item?.name ?? "").toLowerCase().includes("apple silicon")
);

const windowsItem = items.find((item: any) =>
  String(item?.name ?? "").toLowerCase() === "windows"
);

const linuxItem = items.find((item: any) =>
  String(item?.name ?? "").toLowerCase() === "linux"
);

const linuxPackages = Array.isArray(linuxItem?.linux_packages)
  ? linuxItem.linux_packages
  : [];

const windowsGuide = windows_guide ?? {
  title: "",
  tip_label: "",
  tip_question: "",
  tip_assurance: "",
  tip_reason: "",
  tip_action: "",
  image: "",
  image_alt: "",
  video_url: "",
  video_title: "",
};
---

<Base title={meta_title} description={meta_description} footerVariant="home">
  <PageHeader title={title} />
  
  <!-- Downloads Section -->
  <section class="section py-0 mt-0 mb-0">
    <div class="container">
      <div class="row">

        <div class="mx-auto text-center lg:col-12">
          <h2
            class="mt-12 mb-6 text-center"
            data-aos="fade-up-sm"
            data-aos-delay="50"
            set:html={markdownify(description || "")}
          />
        </div>

        <!-- Download Cards -->
        <div class="col-12">
          <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

            <!-- Mac Card -->
            <div
              class="relative overflow-hidden rounded-[22px] border border-[#BBD9FF] bg-white px-6 py-5 lg:min-h-[390px]"
            >
              <!-- Platform Icon -->
              <div class="mb-5 flex justify-center">
                <div class="flex h-16 w-16 items-center justify-center rounded-full bg-[#F1F7FF]">
                  <img
                    src={macIntel?.image}
                    alt={macIntel?.name}
                    class="h-9 w-9 object-contain"
                  />
                </div>
              </div>

              <!-- Platform Info -->
              <div class="text-center">
                <h3 class="mb-2 text-lg font-semibold text-dark">
                  {macIntel?.name}
                </h3>

                <p class="mx-auto mb-4 max-w-[330px] text-sm leading-5 text-gray-600">
                  {macIntel?.description}
                </p>
              </div>

              <DownloadButton
                href={macIntel?.url}
                label={macIntel?.button_text}
                fileSize={macIntel?.file_size}
                sizeLabel={size_label}
                icon={download_icon}
              />

              <div class="my-4 h-px bg-gray-200"></div>

              <div class="text-center">
                <h3 class="mb-2 text-lg font-semibold text-dark">
                  {macSilicon?.name}
                </h3>

                <p class="mx-auto mb-4 max-w-[330px] text-sm leading-5 text-gray-600">
                  {macSilicon?.description}
                </p>
              </div>

              <DownloadButton
                href={macSilicon?.url}
                label={macSilicon?.button_text}
                fileSize={macSilicon?.file_size}
                sizeLabel={size_label}
                icon={download_icon}
              />
            </div>

            <!-- Windows Card -->
            <div
              class="relative overflow-hidden rounded-[22px] border border-[#BBD9FF] bg-white px-6 py-5 lg:min-h-[390px]"
            >
              <div class="mb-5 flex justify-center">
                <div class="flex h-16 w-16 items-center justify-center rounded-full bg-[#F1F7FF]">
                  <img
                    src={windowsItem?.image}
                    alt={windowsItem?.name}
                    class="h-9 w-9 object-contain"
                  />
                </div>
              </div>

              <div class="text-center">
                <h3 class="mb-2 text-lg font-semibold text-dark">
                  {windowsItem?.name}
                </h3>

                <p class="mx-auto mb-6 max-w-[330px] text-sm leading-5 text-gray-600">
                  {windowsItem?.description}
                </p>
              </div>

              <DownloadButton
                href={windowsItem?.url}
                label={windowsItem?.button_text}
                fileSize={windowsItem?.file_size}
                sizeLabel={size_label}
                icon={download_icon}
              />

              <div class="my-4 h-px bg-gray-200"></div>

              <div class="flex items-start gap-3 px-1 text-left text-sm leading-5 text-dark">
                <img
                  src={check_icon}
                  alt=""
                  aria-hidden="true"
                  class="mt-0.5 h-6 w-6 shrink-0 object-contain"
                />

                <p set:html={windowsItem?.download_notice} />
              </div>
            </div>

            <!-- Linux Card -->
            <div
              class="relative overflow-hidden rounded-[22px] border border-[#BBD9FF] bg-white px-6 py-5 lg:min-h-[390px]"
            >
              <div class="mb-5 flex justify-center">
                <div class="flex h-16 w-16 items-center justify-center rounded-full bg-[#F1F7FF]">
                  <img
                    src={linuxItem?.image}
                    alt={linuxItem?.name}
                    class="h-9 w-9 object-contain"
                  />
                </div>
              </div>

              <div class="text-center">
                <h3 class="mb-2 text-lg font-semibold text-dark">
                  {linuxItem?.name}
                </h3>

                <p class="mx-auto mb-6 max-w-[330px] text-sm leading-5 text-gray-600">
                  {linuxItem?.description}
                </p>
              </div>

              <div class="flex flex-col gap-3">
                {linuxPackages.map((pkg: any) => (
                  <DownloadButton
                    href={pkg.url}
                    label={pkg.button_text}
                    fileSize={pkg.file_size}
                    sizeLabel={size_label}
                    icon={download_icon}
                  />
                ))}
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>
  <!-- /.Downloads Section -->


