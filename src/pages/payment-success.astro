---
import Base from "@/layouts/Base.astro";

import { getEntry } from "astro:content";
import videos from "@/config/video.json";
import "../styles/home-video-dialog.css";

const paymentSuccessPageData = await getEntry("payment-success", "-index");
if (!paymentSuccessPageData) {
  throw new Error("Payment success content not found.");
}

const {
  meta_title,
  meta_description,
  payment,
  activation,
  tutorials,
  support,
  footer,
} = paymentSuccessPageData.data;

const codingVideo = videos.codingInterviewCopilot;
const interviewVideo = videos.interviewCopilot;
const zoomVideo = videos.zoomDemo;
---

<Base hideFooter headerVariant="payment-success" title={meta_title} description={meta_description} noindex>
  <main>
    <!-- Payment Success -->
    <section class="pt-12 pb-14 md:pb-16">
      <div class="container mx-auto px-4">
        <div class="mx-auto max-w-[720px] text-center">
          <div class="mb-4 flex items-center justify-center gap-3">
            <h1 class="font-['Asul',serif] text-balance text-[28px] font-bold leading-tight text-dark sm:text-[34px]">
              {payment.title}
            </h1>

            <!-- Success icon + confetti anchor -->
            <span
              id="payment-success-icon"
              class="relative inline-flex h-9 w-9 shrink-0 scale-0 items-center justify-center rounded-full bg-[#315FBD]"
              aria-hidden="true"
            >
              <svg
                class="h-[20px] w-[20px]"
                viewBox="0 0 24 24"
                fill="none"
              >
                <path
                  id="payment-success-check"
                  d="M5 12.5L9.5 17L19 7.5"
                  stroke="white"
                  stroke-width="2.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </div>
          <p class="mx-auto mb-6 max-w-[620px] font-['DM Sans',sans-serif] text-balance text-[15px] font-normal leading-[1.35] text-dark md:text-[20px] lg:text-[20px]">
            {payment.description}
          </p>
          <a
            href={payment.downloadButton.href}
            class="inline-flex h-11 items-center justify-center gap-2 rounded-lg border border-[#315FBD] px-5 text-[16px] font-semibold text-[#315FBD] transition-colors hover:bg-[#315FBD] hover:text-white"
          >
            {payment.downloadButton.text}
            <img
              src={payment.downloadButton.icon}
              alt=""
              width="17"
              height="17"
              aria-hidden="true"
            />
          </a>
        </div>
      </div>
    </section>

    
    <!-- Activation -->
    <section class="pb-14 md:pb-16 lg:pb-20">
      <div class="container mx-auto px-4">
        <h2 class="mx-auto mb-2 text-center font-['Asul',serif] text-balance text-[24px] font-bold leading-tight text-dark sm:text-[28px] md:text-[34px]"
            style="max-width: 700px">
            {activation.title}
        </h2>
        <p class="mx-auto mb-7 max-w-[760px] text-center font-['DM Sans',sans-serif] text-balance text-[15px] font-normal leading-[1.35] text-dark md:text-[20px] lg:text-[20px]">
          {activation.description}
        </p>
        <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
          {
            activation.steps.map((step, index) => (
              <article class="overflow-hidden rounded-lg border border-[#E2E4E9] bg-white shadow-sm">
                <div class="aspect-[375/340] overflow-hidden border-b border-[#E2E4E9] bg-[#F8F9FB]">
                  <img
                    src={step.image}
                    alt={step.alt ?? step.title}
                    loading={index === 0 ? "eager" : "lazy"}
                    class="h-full w-full object-cover object-top"
                  />
                </div>
                <div class="flex min-h-[52px] items-center gap-3 px-3 py-3">
                  <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#EEF3FF] text-base font-semibold text-[#315FBD]">
                    {index + 1}
                  </span>
                  <p class="text-[15px] font-medium leading-[1.4] text-dark md:text-[18px]">
                    {step.title}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>


    <!-- Tutorials -->
    <section class="pb-16 md:pb-20 lg:pb-24">
      <div class="container mx-auto px-4">
        <h2 class="mx-auto mb-2 text-center font-['Asul',serif] text-balance text-[24px] font-bold leading-tight text-dark sm:text-[28px] md:text-[34px]" style="max-width: 700px">
          {tutorials.title}
        </h2>
        <p class="mx-auto mb-7 max-w-[760px] text-center font-['DM Sans',sans-serif] text-balance text-[15px] font-normal leading-[1.35] text-dark md:text-[20px] lg:text-[20px]">
          {tutorials.description}
        </p>
        <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
          {
            [
              { video: codingVideo, title: tutorials.cards.codingInterviewCopilot.title, description: tutorials.cards.codingInterviewCopilot.description, coverImage: tutorials.cards.codingInterviewCopilot.coverImage, playButtonImage: tutorials.cards.codingInterviewCopilot.playButtonImage },
              { video: interviewVideo, title: tutorials.cards.interviewCopilot.title, description: tutorials.cards.interviewCopilot.description, coverImage: tutorials.cards.interviewCopilot.coverImage, playButtonImage: tutorials.cards.interviewCopilot.playButtonImage },
              { video: zoomVideo, title: tutorials.cards.zoomDemo.title, description: tutorials.cards.zoomDemo.description, coverImage: tutorials.cards.zoomDemo.coverImage, playButtonImage: tutorials.cards.zoomDemo.playButtonImage },
            ].map((card, index) => (
              <article class="overflow-hidden rounded-lg border border-[#E2E4E9] bg-white shadow-sm">
                <div class="relative w-full overflow-hidden border-b border-[#E2E4E9]" style="padding-bottom:56.25%" data-youtube-container>
                  <button
                    type="button"
                    class="group absolute inset-0 h-full w-full cursor-pointer"
                    aria-label={`Play video: ${card.video.title}`}
                    data-video-dialog
                    data-video-url={card.video.src}
                  >
                    <img
                      class="h-full w-full object-cover"
                      src={card.coverImage}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                    <span
                      class="pointer-events-none absolute inset-0 flex items-center justify-center"
                      aria-hidden="true"
                    >
                      <img
                        class="h-auto w-[68px] drop-shadow-lg transition-transform duration-200 group-hover:scale-105 sm:w-[76px] md:w-20"
                        src={card.playButtonImage}
                        alt=""
                        width="80"
                        height="56"
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                  </button>
                </div>

                <div class="px-4 py-4">
                  <h3 class="mb-2 text-[15px] font-semibold leading-[1.4] text-dark md:text-[18px]">
                    {card.title}
                  </h3>

                  <p class="text-[14px] leading-[1.5] text-dark/80 md:text-[17px]">
                    {card.description}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>


    <!-- Support -->
    <section class="bg-[#EEF2F8] py-12 md:py-14 lg:py-16">
      <div class="container mx-auto px-28">
        <div class="grid grid-cols-1 items-start gap-10 md:grid-cols-[1fr_280px] lg:grid-cols-[1fr_300px]">
          <div>
            <h2 class="mb-4 font-['Asul',serif] text-balance text-[24px] font-bold leading-tight text-dark sm:text-[28px] md:text-[34px]">
              {support.title}
            </h2>

            <p class="font-['DM Sans',sans-serif] text-balance text-[15px] font-normal leading-[1.35] text-dark md:text-[20px] lg:text-[20px]">
              {support.description}
            </p>
          </div>

          <div class="flex flex-col gap-4">
            <!-- Discord -->
            <a
              href={support.discord.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex min-h-[60px] items-center gap-4 rounded-lg border border-[#DADDE3] bg-white px-4 transition-all hover:-translate-y-[1px] hover:border-[#C6CBD4] hover:shadow-sm"
            >
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-[#E3E5E9] bg-white">
                <img
                  src={support.discord.icon}
                  alt=""
                  width="22"
                  height="22"
                  aria-hidden="true"
                />
              </span>

              <span class="text-[14px] font-medium text-dark md:text-[15px]">
                {support.discord.label}
              </span>
            </a>

            <!-- WhatsApp -->
            <a
              href={support.whatsapp.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex min-h-[60px] items-center gap-4 rounded-lg border border-[#DADDE3] bg-white px-4 transition-all hover:-translate-y-[1px] hover:border-[#C6CBD4] hover:shadow-sm"
            >
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-[#E3E5E9] bg-white">
                <img
                  src={support.whatsapp.icon}
                  alt=""
                  width="22"
                  height="22"
                  aria-hidden="true"
                />
              </span>

              <span class="text-[14px] font-medium text-dark md:text-[15px]">
                {support.whatsapp.label}
              </span>
            </a>

            <!-- Email -->
            <a
              href={support.email.href}
              class="group flex min-h-[60px] items-center gap-4 rounded-lg border border-[#DADDE3] bg-white px-4 transition-all hover:-translate-y-[1px] hover:border-[#C6CBD4] hover:shadow-sm"
            >
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-[#E3E5E9] bg-white">
                <img
                  src={support.email.icon}
                  alt=""
                  width="22"
                  height="22"
                  aria-hidden="true"
                />
              </span>

              <span class="min-w-0">
                <span class="block text-[14px] font-medium text-dark md:text-[15px]">
                  {support.email.label}
                </span>

                <span class="block break-all text-[12px] text-dark/70 md:text-[13px]">
                  {support.email.email}
                </span>
              </span>
            </a>
          </div>
        </div>
      </div>
    </section>


    <!-- Footer -->
    <footer class="border-t border-[#ECEDEF] bg-white py-8">
      <div class="container mx-auto px-4 text-center">
        <p class="text-[14px] text-dark md:text-[15px]">
          {footer.copyright}
          {" "}
          <a href={footer.brandLink}><strong>{footer.brand}</strong></a>
        </p>
      </div>
    </footer>
  </main>
</Base>



<!-- Success animation -->
<script>
  import confetti from "canvas-confetti";

  const runPaymentSuccessAnimation = () => {
    const icon = document.querySelector(
      "#payment-success-icon",
    ) as HTMLElement | null;

    const check = document.querySelector(
      "#payment-success-check",
    ) as SVGPathElement | null;

    if (!icon || !check) return;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reduceMotion) {
      icon.style.transform = "scale(1)";
      return;
    }

    /*
     * Circle bounce:
     * scale 0 → 1.14 → 0.96 → 1
     */
    icon.animate(
      [
        {
          transform: "scale(0)",
          opacity: 0,
        },
        {
          transform: "scale(1.14)",
          opacity: 1,
          offset: 0.65,
        },
        {
          transform: "scale(0.96)",
          opacity: 1,
          offset: 0.82,
        },
        {
          transform: "scale(1)",
          opacity: 1,
        },
      ],
      {
        duration: 480,
        easing: "cubic-bezier(0.34, 1.56, 0.64, 1)",
        fill: "forwards",
      },
    );

    /*
     * Draw white check.
     */
    const length = check.getTotalLength();

    check.style.strokeDasharray = `${length}`;
    check.style.strokeDashoffset = `${length}`;

    check.animate(
      [
        {
          strokeDashoffset: length,
        },
        {
          strokeDashoffset: 0,
        },
      ],
      {
        duration: 320,
        delay: 220,
        easing: "ease-out",
        fill: "forwards",
      },
    );

    /*
     * Small local confetti burst around the icon.
     */
    window.setTimeout(() => {
      const rect = icon.getBoundingClientRect();

      const x =
        (rect.left + rect.width / 2) /
        window.innerWidth;

      const y =
        (rect.top + rect.height / 2) /
        window.innerHeight;

      confetti({
        particleCount: 18,
        spread: 55,
        startVelocity: 18,
        gravity: 0.8,
        scalar: 0.7,
        ticks: 100,

        origin: {
          x,
          y,
        },

        colors: [
                "#F6C85F",
                "#9B8AFB",
                "#F28AB2",
                "#5BCB9D",
                "#F59E6C",
                "#6EA8E8",
                ],

        disableForReducedMotion: true,
      });
    }, 380);
  };

  if (document.readyState === "loading") {
  document.addEventListener(
      "DOMContentLoaded",
    runPaymentSuccessAnimation,
      {
          once: true,
        },
  );
  } else {
    runPaymentSuccessAnimation();
  }
</script>

<script is:inline type="module" src="/js/home-video-dialog.js"></script>

<!-- YouTube facade: lazy-load iframe on click -->
<script>
  let _youtubePreconnected = false;

  function _preconnectYouTube() {
    if (_youtubePreconnected) return;
    _youtubePreconnected = true;
    for (const origin of ['https://www.youtube.com', 'https://i.ytimg.com']) {
      const link = document.createElement('link');
      link.rel = 'preconnect';
      link.href = origin;
      link.crossOrigin = 'anonymous';
      document.head.appendChild(link);
    }
  }

  document.addEventListener('pointerdown', (e) => {
    const btn = (e.target as HTMLElement)?.closest?.('[data-youtube-facade]');
    if (btn) _preconnectYouTube();
  }, { passive: true, capture: true });

  document.addEventListener('mouseenter', (e) => {
    const btn = (e.target as HTMLElement)?.closest?.('[data-youtube-facade]');
    if (btn) _preconnectYouTube();
  }, { passive: true, capture: true });

  document.addEventListener('focusin', (e) => {
    const btn = (e.target as HTMLElement)?.closest?.('[data-youtube-facade]');
    if (btn) _preconnectYouTube();
  }, { passive: true, capture: true });

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement)?.closest?.('[data-youtube-facade]');
    if (!(btn instanceof HTMLButtonElement)) return;

    const container = btn.closest('[data-youtube-container]');
    if (!container) return;

    const src = btn.getAttribute('data-youtube-src');
    const title = btn.getAttribute('data-youtube-title') || '';
    if (!src) return;

    e.preventDefault();

    const url = new URL(src);
    url.searchParams.set('autoplay', '1');

    const iframe = document.createElement('iframe');
    iframe.src = url.toString();
    iframe.title = title;
    iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
    iframe.setAttribute('allowfullscreen', '');
    iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
    iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;';

    container.textContent = '';
    container.appendChild(iframe);
  });
</script>
