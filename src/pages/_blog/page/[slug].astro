---
import BlogCard from "@/components/BlogCard.astro";
import Pagination from "@/components/Pagination.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { markdownify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import PageHeader from "@/partials/PageHeader.astro";
import { getEntry } from "astro:content";

const BLOG_FOLDER = "blog";

const { slug } = Astro.params;
const postIndex = await getEntry(BLOG_FOLDER, "-index");
if (!postIndex) {
  throw new Error("Blog index file not found");
}
const posts = await getSinglePage(BLOG_FOLDER);
const sortedPosts = sortByDate(posts);
const totalPages = Math.ceil(posts.length / config.settings.pagination);
const currentPage = slug && !isNaN(Number(slug)) ? Number(slug) : 1;
const indexOfLastPost = currentPage * config.settings.pagination;
const indexOfFirstPost = indexOfLastPost - config.settings.pagination;
const currentPosts = sortedPosts.slice(indexOfFirstPost, indexOfLastPost);

// Generate unique SEO info for paginated pages
const pageTitle = `${postIndex.data.title} - Page ${currentPage}`;
const pageDescription = `${postIndex.data.description || config.metadata.meta_description} - Page ${currentPage} of ${totalPages}`;

// Generate prev and next links
const prevUrl = currentPage > 1 ? 
  (currentPage === 2 ? `${config.site.base_url}${BLOG_FOLDER}/` : `${config.site.base_url}${BLOG_FOLDER}/page/${currentPage - 1}/`) : 
  undefined;
const nextUrl = currentPage < totalPages ? `${config.site.base_url}${BLOG_FOLDER}/page/${currentPage + 1}/` : undefined;

export async function getStaticPaths() {
  const BLOG_FOLDER = "blog";
  const posts = await getSinglePage(BLOG_FOLDER);
  const totalPages = Math.ceil(posts.length / config.settings.pagination);
  const paths = [];

  for (let i = 1; i < totalPages; i++) {
    paths.push({
      params: {
        slug: (i + 1).toString(),
      },
    });
  }
  return paths;
}
---

<Base 
  {...postIndex.data} 
  title={pageTitle}
  description={pageDescription}
  prev_url={prevUrl}
  next_url={nextUrl}
>
  <PageHeader title={postIndex.data.title} />

  <section class="section pb-0">
    <div class="container">
      <!-- <div class="row">
        <div class="mx-auto text-center lg:col-7">
          <div
            class="section-heading-shape"
            aria-label="shape"
            data-aos="fade-up-sm"
          >
          </div>
          <h2
            class="mb-6"
            data-aos="fade-up-sm"
            data-aos-delay="50"
            set:html={markdownify(postIndex.data.title)}
          />
          <p
            data-aos="fade-up-sm"
            data-aos-delay="150"
            set:html={markdownify(postIndex.data.description!)}
          />
        </div>
      </div> -->
      <div
        class="row g-4 pt-10 md:pt-20"
        data-aos="fade-up-sm"
        data-aos-delay="150"
      >
        {currentPosts.map((post) => <BlogCard data={post} />)}

        <Pagination
          section={BLOG_FOLDER}
          currentPage={currentPage}
          totalPages={totalPages}
        />
      </div>
    </div>
  </section>

  <CallToAction />
</Base>
