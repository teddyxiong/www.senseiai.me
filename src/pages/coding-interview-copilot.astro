---
import DynamicIcon from "@/helpers/DynamicIcon";
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import PageHeader from "@/partials/PageHeader.astro";
import FAQ from "@/partials/FAQ.astro";
import Testimonial from "@/partials/Testimonialcoding.astro";
import Undetectable from "@/partials/undetectablecoding.astro";
import PlatformStatusList from '@/layouts/components/PlatformStatusList.astro';

import { getEntry } from "astro:content";
import videos from "@/config/video.json";

const codingInterviewCopilotPageData = await getEntry("coding-interview-copilot", "-index");
if (!codingInterviewCopilotPageData) {
  throw new Error("coding-interview-copilot page data not found");
}
const { challenges_section, explore_section, inbound_solution, tools_section } =
  codingInterviewCopilotPageData.data;

const testimonial = await getEntry("sections", "testimonialcoding");
if (!testimonial) {
  throw new Error("testimonialcoding data not found");
}
const testimonialCopy = testimonial as unknown as { data: { title: string; description: string } };
const testimonialCopyTitle = testimonialCopy.data.title;
const testimonialCopyDescription = testimonialCopy.data.description;

const faqEntry = await getEntry("sections", "faqcoding");
if (!faqEntry) {
  throw new Error("faqcoding data not found");
}

const ctaEntry = await getEntry("sections", "call-to-action-coding");
if (!ctaEntry) {
  throw new Error("call-to-action-coding data not found");
}
const video = videos.codingInterviewCopilot;

const undetectable = await getEntry("sections", "undetectablecoding");

const exploreFeatures = explore_section.features.filter(
  (feature: { title: string }) =>
    ![
      "Nowhere on Your Dock",
      "Invisible in Activity Monitor",
      "Screen-Recording Proof",
      "Completely Click-Through. Truly Invisible",
    ].includes(feature.title)
);
---

<Base {...codingInterviewCopilotPageData.data} footerVariant="home">
  <PageHeader title={codingInterviewCopilotPageData.data.title} />

  <!-- challenges_section -->
  <section class="section pt-0 pb-0">
    <div class="container">
      <div class="row">
        <div class="mx-auto text-center lg:col-12 xl:col-12">
          <div class="mb-2 h-10" data-aos="fade-up-sm" aria-hidden="true"></div>
          <h2
            class="mb-6 mx-auto text-center"
            style="max-width: 750px; font-family: Asul, serif; font-weight: 700; line-height: 1.2;"
            data-aos="fade-up-sm"
            data-aos-delay="50"
            set:html={markdownify(challenges_section.title)}
          />
          <p
            data-aos="fade-up-sm"
            data-aos-delay="150"
            class="mb-10 text-[15px] md:text-[18px] lg:text-[20px] text-center aos-init aos-animate text-dark"
            set:html={markdownify(challenges_section.description)}
          />
          <div class="hero-webm mx-auto w-full mt-10" data-aos="fade-up-sm" data-aos-delay="200">
            <div class="w-full overflow-hidden rounded-xl md:rounded-2xl border border-[#D0E7FB] bg-white/5 shadow-sm">
              <img
                src="/images/codinginterviewcopilot.webp"
                alt="Coding Interview Copilot"
                class="w-full h-auto"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                width="1422"
                height="800"
              />
            </div>
          </div>
        </div>

        <div
          class="col-12 pt-5 md:pt-10"
          data-aos="fade-up-sm"
          data-aos-delay="250"
        >
          <div class="row rounded-3xl">
            {
              challenges_section.challenges.map(
                (challenge: {
                  title: string;
                  description: string;
                  icon: string;
                }) => (
                  <div class="after:bg-gradient-primary relative border p-7 transition-colors duration-300 after:absolute after:left-0 after:top-0 after:-z-10 after:h-full after:w-full after:opacity-0 after:duration-300 hover:border-transparent hover:text-white hover:after:opacity-100 sm:p-10 lg:col-6">
                    <div class="flex flex-wrap items-center">
                      <div class="mb-6 mr-3 h-[50px] w-[50px] rounded-full border text-center text-lg leading-[50px] sm:h-[56px] sm:w-[56px] sm:text-2xl sm:leading-[56px] flex items-center justify-center">
                        <DynamicIcon icon={challenge.icon} />
                      </div>
                      <h3
                        class="h4 mb-4 inline-block text-inherit"
                        set:html={markdownify(challenge.title)}
                      />
                    </div>
                    <p set:html={markdownify(challenge.description)} />
                  </div>
                )
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

<!-- youtube_video_section  -->
 <section class="section pb-0">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-12">
          <div
            class="relative w-full overflow-hidden rounded-xl border border-gray-200 bg-white/50 shadow-sm"
            style="padding-bottom:56.25%"
            data-youtube-container
          >
            <button
              type="button"
              class="group absolute inset-0 h-full w-full cursor-pointer"
              aria-label={`Play video: ${video.title}`}
              data-youtube-facade
              data-youtube-src={video.src}
              data-youtube-title={video.title}
            >
              <img
                class="h-full w-full object-cover"
                src="/images/features/interview-copilot-cover.webp"
                alt=""
                loading="lazy"
                decoding="async"
              />
              <span
                class="pointer-events-none absolute inset-0 flex items-center justify-center"
                aria-hidden="true"
              >
                <img
                  class="h-auto w-[68px] drop-shadow-lg transition-transform duration-200 group-hover:scale-105 sm:w-[76px] md:w-20"
                  src="/images/features/youtube-button.webp"
                  alt=""
                  width="80"
                  height="56"
                  loading="lazy"
                  decoding="async"
                />
              </span>
            </button>
            <!-- <div class="absolute left-1/2 -translate-x-1/2 bottom-14 z-10 pointer-events-none bg-[#391F5C] text-white text-4xl rounded-[8px] px-3 py-2 shadow text-center">
              {video.overlayText}
            </div> -->
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- explore_section  -->
  <section class="section-sm">
    <div class="container">
      <div class="row">
        <div class="mx-auto text-center lg:col-12 xl:col-12">
          <div class="mb-2 h-10" data-aos="fade-up-sm" aria-hidden="true"></div>
          <h2
            class="mb-6 mx-auto text-center"
            style="max-width: 600px; font-family: Asul, serif; font-weight: 700; line-height: 1.2;"
            data-aos="fade-up-sm"
            data-aos-delay="50"
            set:html={markdownify(explore_section.title)}
          />
          <p
            data-aos="fade-up-sm"
            data-aos-delay="150"
            class="mb-0 mx-auto text-[15px] md:text-[18px] lg:text-[20px] text-center aos-init aos-animate text-dark"
            style="max-width: 1000px;"
            set:html={markdownify(explore_section.description)}
          />
           <!-- <img
            src="/images/coding-invisible.webp"
            alt="Coding Interview Copilot"
            class="w-full h-auto rounded-lg shadow-lg  cursor-pointer transition-all  duration-300 hover:scale-105"
          /> -->
        </div>
      </div>
    </div>
  </section>
<PlatformStatusList />
  <Undetectable undetectable={undetectable?.data} />
  <section class="section pt-0 pb-0">
    <div class="container">
      <div class="row">
        <div class="mx-auto text-center lg:col-12 xl:col-12">
          <h2
            class="mt-6 mb-4 mx-auto text-center"
            style="max-width: 600px; font-family: Asul, serif; font-weight: 700; line-height: 1.2;"
            data-aos="fade-up-sm"
            data-aos-delay="50"
            set:html={markdownify(explore_section.mastery_title ?? "")}
          />
          <p
            data-aos="fade-up-sm"
            data-aos-delay="150"
            class="mb-10 mx-auto text-[15px] md:text-[18px] lg:text-[20px] text-center aos-init aos-animate text-dark"
            style="max-width: 1000px;"
            set:html={markdownify(explore_section.mastery_description ?? "")}
          />
        </div>
      </div>
    </div>
  </section>
  {
    exploreFeatures.map(
      (
        feature: {
          title: string;
          description: string;
          image: string;
          lists?: string[] | null;
        },
        i: number
      ) => {
        const lists = Array.isArray(feature.lists)
          ? feature.lists.filter((list) => list && list.trim())
          : [];

        return (
          <section
            class={`section pt-10 pb-10 ${
              i === explore_section.features.length - 1 || i % 2 !== 0
                ? ""
                : "section-gradient pb-0"
            }`}
          >
            <div class="container">
              <div
                class={`row items-center ${i % 2 === 0 ? "max-lg:gy-5 max-lg:flex-col-reverse" : "max-lg:gy-5"}`}
              >
                <div
                  class={`lg:col-6 ${i % 2 === 0 ? "" : "order-last"}`}
                  data-aos="fade-left-sm"
                  data-aos-delay="100"
                >
                  <h3
                    class="mb-6"
                    style="font-family: Asul, serif; font-weight: 700; line-height: 1.2;"
                    set:html={markdownify(feature.title)}
                  />
                  <p class="mb-6" set:html={markdownify(feature.description)} />
                  <div
                    class="gradient gradient-horizontal gradient-to-right w-full"
                    aria-label="horizontal line"
                  />
                  {
                    lists.length > 0 && (
                      <ul class="list list-check pt-6">
                        {lists.map((list) => (
                          <li>{list}</li>
                        ))}
                      </ul>
                    )
                  }
                </div>
                <div
                  class={`lg:col-6 ${i % 2 === 0 ? "order-last" : ""}`}
                  data-aos="fade-left-sm"
                  data-aos-delay="150"
                >
                  <img
                    width="576"
                    class="mx-auto lg:mx-0 lg:pl-6 xl:pl-12"
                    src={feature.image}
                    alt={feature.title}
                  />
                </div>
              </div>
            </div>
          </section>
        );
      }
    )
  }

  <!-- Inbound Solution -->
  <!-- <section class="section section-gradient">
    <div class="container">
      <div class="row">
        <div class="mx-auto text-center lg:col-8 xl:col-6">
          <h2
            class="mb-6"
            data-aos="fade-up-sm"
            data-aos-delay="50"
            set:html={markdownify(inbound_solution.title)}
          />
          <p
            class="mb-10"
            data-aos="fade-up-sm"
            data-aos-delay="150"
            set:html={markdownify(inbound_solution.description)}
          />
          {
            inbound_solution.button.enable && (
              <div data-aos="fade-up-sm" data-aos-delay="200">
                <a href={inbound_solution.button.link} class="btn btn-primary">
                  {inbound_solution.button.label}
                </a>
              </div>
            )
          }
        </div>
      </div>
      
      <div class="row pt-10">
        <div class="col-12">
          <div class="row g-3 sm:g-4 justify-center">
            {
              inbound_solution.solutions.map((solution: any, i: number) => (
                <div class="sm:col-6 lg:col-3">
                  <div
                    class="bg-gradient-primary rounded-lg p-6 text-center text-white sm:p-8"
                    data-aos="fade-up-sm"
                    data-aos-delay={100 + i * 50}
                  >
                    <div class="mx-auto mb-5 h-[50px] w-[50px] rounded-full bg-white/20 text-center text-lg leading-[50px] sm:h-[64px] sm:w-[64px] sm:text-2xl sm:leading-[64px] flex items-center justify-center">
                      <DynamicIcon icon={solution.icon} />
                    </div>
                    <h3
                      class="h4 mb-2 text-inherit"
                      set:html={markdownify(solution.title)}
                    />
                    <p
                      class="text-sm text-light"
                      set:html={markdownify(solution.description)}
                    />
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section> -->

  <!-- tools  -->
  {
    tools_section.enable && (
      <section>
        <div class="container">
          <div class="row">
            <div class="mx-auto text-center lg:col-9 xl:col-7">
              <div class="mb-2 h-10" data-aos="fade-up-sm" aria-hidden="true"></div>
              <h2
                class="mb-6 mx-auto text-center"
                style="max-width: 800px; font-family: Asul, serif; font-weight: 700; line-height: 1.2;"
                data-aos="fade-up-sm"
                data-aos-delay="50"
                set:html={markdownify(tools_section.title)}
              />
            </div>
            <div class="col-12" data-aos="fade-up-sm" data-aos-delay="150">
              <div class="flex flex-wrap justify-center gap-5 pt-10 lg:gap-y-10">
                {tools_section.tools.map(
                  (tool: { name: string; logo: string }) => (
                    <div class="group relative basis-[70px] rounded-xl py-4 shadow transition-all duration-300 hover:-translate-y-4 md:basis-[100px] md:py-5 lg:basis-[134px] lg:py-8">
                      <img
                        src={tool.logo}
                        class="mx-auto block h-[36px] w-[36px] object-cover md:h-[56px] md:w-[56px]"
                        alt="brand logo"
                      />
                      <span class="absolute -bottom-8 left-1/2 -translate-x-1/2 text-xs opacity-0 transition-all duration-300 group-hover:-bottom-7 group-hover:opacity-100 sm:text-sm">
                        {markdownify(tool.name)}
                      </span>
                    </div>
                  )
                )}
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }
  <Testimonial
    testimonial={testimonial}
    titleHtml={testimonialCopyTitle}
    descriptionHtml={testimonialCopyDescription}
    className="mt-10 mb-12"
  />
  <FAQ variant="home" data={faqEntry.data} />
  <CallToAction variant="home" data={ctaEntry.data} />
</Base>

<script>
  // YouTube facade: lazy-load iframe on click
  let _youtubePreconnected = false;

  function _preconnectYouTube() {
    if (_youtubePreconnected) return;
    _youtubePreconnected = true;
    for (const origin of ['https://www.youtube.com', 'https://i.ytimg.com']) {
      const link = document.createElement('link');
      link.rel = 'preconnect';
      link.href = origin;
      link.crossOrigin = 'anonymous';
      document.head.appendChild(link);
    }
  }

  document.addEventListener('pointerdown', (e) => {
    const btn = (e.target as HTMLElement)?.closest?.('[data-youtube-facade]');
    if (btn) _preconnectYouTube();
  }, { passive: true, capture: true });

  document.addEventListener('mouseenter', (e) => {
    const btn = (e.target as HTMLElement)?.closest?.('[data-youtube-facade]');
    if (btn) _preconnectYouTube();
  }, { passive: true, capture: true });

  document.addEventListener('focusin', (e) => {
    const btn = (e.target as HTMLElement)?.closest?.('[data-youtube-facade]');
    if (btn) _preconnectYouTube();
  }, { passive: true, capture: true });

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement)?.closest?.('[data-youtube-facade]');
    if (!(btn instanceof HTMLButtonElement)) return;

    const container = btn.closest('[data-youtube-container]');
    if (!container) return;

    const src = btn.getAttribute('data-youtube-src');
    const title = btn.getAttribute('data-youtube-title') || '';
    if (!src) return;

    e.preventDefault();

    const url = new URL(src);
    url.searchParams.set('autoplay', '1');

    const iframe = document.createElement('iframe');
    iframe.src = url.toString();
    iframe.title = title;
    iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
    iframe.setAttribute('allowfullscreen', '');
    iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
    iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0;border-radius:20px';

    container.textContent = '';
    container.appendChild(iframe);
  });
</script>
