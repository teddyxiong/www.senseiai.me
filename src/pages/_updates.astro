---
import Base from "@/layouts/Base.astro";
import { getEntry } from "astro:content";

const updatesIndex = await getEntry("updates", "-index");
if (!updatesIndex) {
  throw new Error("Updates data not found");
}

const { title, meta_title, description, updates } = updatesIndex.data;
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  headerVariant="no-locale"
>
  <section class="section pt-10 pb-16 md:pt-14 md:pb-20">
    <div class="container">
      <div class="mx-auto" style="max-width: 720px;">
        <h1
          class="mb-10 text-[30px] md:text-[36px] text-dark"
          style="font-family: Asul, serif; font-weight: 700; line-height: 1.2;"
        >
          {title}
        </h1>

        <ul class="flex flex-col">
          {updates.map((item, idx) => (
            <li
              class={`flex flex-col py-8 ${idx === 0 ? "pt-0" : ""} ${
                idx === updates.length - 1 ? "pb-0" : "border-b border-border"
              }`}
            >
              <div class="text-[13px] font-medium text-gray-400">
                {item.date}
              </div>
              <h2
                class="mt-2 text-[18px] md:text-[20px] text-dark"
                style="font-family: 'DM Sans', sans-serif; font-weight: 700; line-height: 1.35;"
              >
                {item.title}
              </h2>
              <div class="mt-3">
                <span
                  class={`tag-pill tag-${item.tag
                    .toLowerCase()
                    .replace(/\s+/g, "-")}`}
                >
                  {item.tag}
                </span>
              </div>
              <p
                class="mt-3 text-[15px] leading-relaxed text-dark/70"
                style="font-family: 'DM Sans', sans-serif; font-weight: 400;"
              >
                {item.description}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <style is:global>
    .tag-pill {
      display: inline-block;
      border-radius: 9999px;
      padding: 0.125rem 0.625rem;
      font-size: 12px;
      font-weight: 700;
      line-height: 1.5;
    }
    .tag-improvement {
      color: #2e5aac;
      background: #eef2fa;
    }
    .tag-new-feature {
      color: #287d3c;
      background: #edf9f0;
    }
    .tag-tag1 {
      color: #b95000;
      background: #fff4ec;
    }
    .tag-tag2 {
      color: #6d7580;
      background: #ebeef2;
    }
    .tag-tag3 {
      color: #da1414;
      background: #feefef;
    }
  </style>
</Base>