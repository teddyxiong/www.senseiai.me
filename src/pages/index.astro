    class="home-hero section pt-12 md:pt-16 pb-16 md:pb-32 bg-index-hero bg-index-hero--home bg-index-hero-overlay relative rounded-t-[10px] text-white md:rounded-t-[10px]"
  >
    <div class="container relative z-10">
      <div class="row gy-4 items-center">
