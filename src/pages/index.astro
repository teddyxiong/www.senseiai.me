  <style>
    .home-hero-stats {
      display: flex;
      width: min(100%, 959px);
      margin-top: 32px;
      align-items: center;
      justify-content: center;
      gap: 20px;
      font-family: "DM Sans", sans-serif;
    }

    .home-hero-stat {
      display: flex;
      align-items: center;
      gap: 5px;
      line-height: 20.4px;
      white-space: nowrap;
    }

    .home-hero-stat-value {
      color: #4f8fef;
      font-size: 17px;
      font-weight: 700;
    }

    .home-hero-stat-label {
      color: #454a52;
      font-size: 17px;
      font-weight: 500;
    }

    .home-hero-stat-divider {
      width: 1px;
      height: 20px;
      flex: 0 0 auto;
      background: #454a52;
    }

    @keyframes companyLogoMarquee {
      from {
        transform: translateX(0);
      }
      to {
        transform: translateX(-50%);
      }
    }

    .company-logo-marquee {
      --company-logo-edge-fade-width: clamp(48px, 8vw, 120px);
      position: relative;
      overflow: hidden;
      padding: 4px 0;
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 var(--company-logo-edge-fade-width),
        #000 calc(100% - var(--company-logo-edge-fade-width)),
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0,
        #000 var(--company-logo-edge-fade-width),
        #000 calc(100% - var(--company-logo-edge-fade-width)),
        transparent 100%
      );
    }

    .company-logo-marquee-track {
      display: flex;
      width: max-content;
      align-items: center;
      gap: clamp(2rem, 4vw, 4rem);
      animation: companyLogoMarquee var(--company-logo-marquee-duration, 25s)
        linear infinite;
      will-change: transform;
    }

    .company-logo-item {
      display: flex;
      width: clamp(100px, 12vw, 140px);
      flex: 0 0 auto;
      align-items: center;
      justify-content: center;
    }

    .company-logo-item img {
      display: block;
      width: auto;
      height: 40px;
      object-fit: contain;
    }

    @media (max-width: 1023px) {
      .home-hero-stats {
        display: grid;
        grid-template-columns: repeat(2, max-content);
        column-gap: 24px;
        row-gap: 12px;
      }

      .home-hero-stat-divider {
        display: none;
      }
    }

    @media (max-width: 479px) {
      .home-hero-stats {
        grid-template-columns: 1fr;
        row-gap: 10px;
      }

      .home-hero-stat {
        justify-content: center;
      }
    }

    @media (max-width: 849px) {
      .company-logo-marquee {
        -webkit-mask-image: none;
        mask-image: none;
      }
    }
  </style>
  <script>
    const setupCompanyLogoMarquee = () => {
      const track = document.querySelector<HTMLElement>(
        "[data-company-logo-track]",
      );
      if (!track) return;

      const halfWidth = track.scrollWidth / 2;
      if (halfWidth <= 0) return;

      track.style.setProperty(
        "--company-logo-marquee-duration",
        `${Math.max(halfWidth / 50, 8)}s`,
      );
    };

    document.addEventListener("astro:page-load", setupCompanyLogoMarquee);

    function toggleImageSize(img: HTMLImageElement) {
      // Check if overlay already exists
      const existingOverlay = document.getElementById("image-overlay");

      if (existingOverlay) {
        // Close overlay
        existingOverlay.remove();
      } else {
        // Create full-page overlay
        const overlay = document.createElement("div");
        overlay.id = "image-overlay";
        overlay.style.position = "fixed";
        overlay.style.top = "0";
        overlay.style.left = "0";
        overlay.style.width = "100%";
        overlay.style.height = "100%";
        overlay.style.backgroundColor = "rgba(0, 0, 0, 0.9)";
        overlay.style.zIndex = "9999";
        overlay.style.cursor = "pointer";
        overlay.style.display = "flex";
        overlay.style.alignItems = "center";
        overlay.style.justifyContent = "center";
        overlay.style.padding = "20px";

        // Create image clone
        const imgClone = img.cloneNode(true) as HTMLImageElement;
        imgClone.style.maxWidth = "90vw";
        imgClone.style.maxHeight = "90vh";
        imgClone.style.objectFit = "contain";
        imgClone.style.borderRadius = "8px";
        imgClone.style.boxShadow = "0 20px 60px rgba(0, 0, 0, 0.5)";
        imgClone.style.cursor = "pointer";

        // Close overlay on click anywhere
        overlay.onclick = () => {
          overlay.remove();
        };

        // Add image to overlay
        overlay.appendChild(imgClone);

        // Add overlay to page
        document.body.appendChild(overlay);

        // Prevent page scrolling
        document.body.style.overflow = "hidden";

        // Restore page scrolling when overlay is closed
        const originalRemove = overlay.remove;
        overlay.remove = function () {
          document.body.style.overflow = "";
          originalRemove.call(this);
        };
      }
    }

    // Run after page has loaded
    document.addEventListener("DOMContentLoaded", function () {
      // Trial code popup feature has been removed
    });
  </script>
  <script is:inline type="module" src="/js/home-video-dialog.js"></script>
</Base>
