---
import BlogCard from "@/components/BlogCard.astro";
import Brands from "@/components/Brands.astro";
import Counter from "@/helpers/Counter";
import DynamicIcon from "@/helpers/DynamicIcon";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import FAQ from "@/partials/FAQ.astro";
import FeaturesSection from "@/layouts/partials/FeaturesSectionV2.astro";
import PricingSection from "@/partials/PricingSection.astro";
import Testimonial from "@/partials/Testimonial.astro";
import Undetectable from "@/partials/undetectable.astro";
import RSSFeed from "@/components/RSSFeed.astro";
import PopularPosts from "@/partials/PopularPosts.astro";
import { getEntry } from "astro:content";
import { FaCirclePlay } from "react-icons/fa6";
import PlatformStatusList from "@/layouts/components/PlatformStatusList.astro";
import HeroCapabilitySwitcher from "@/partials/HeroCapabilitySwitcher.astro";
import "../styles/home-video-dialog.css";

const BLOG_FOLDER = "blog";
const homepage = await getEntry("homepage", "-index");
const {
  banner,
  brands,
  company_logos: companyLogos = [],
  experience,
  hero_stats: heroStats = [],
  nav_buttons: navButtons = [],
} = (homepage?.data as any) || {}; // Add empty object as default to prevent undefined errors
const testimonial = await getEntry("sections", "testimonial");
const undetectable = await getEntry("sections", "undetectable");
const postIndex = await getEntry(BLOG_FOLDER, "-index");
const posts = await getSinglePage(BLOG_FOLDER);

const pricingIndex = await getEntry("pricing", "-index");
const { pricing } = pricingIndex?.data || {}; // Add empty object as default to prevent undefined errors
