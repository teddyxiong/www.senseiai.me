<script>
  // Wait for DOM to load
  document.addEventListener('DOMContentLoaded', function() {
    const toggleBtn = document.getElementById('toggleNavBtn');
    const leftNavbar = document.getElementById('leftNavbar');
    const leftNavPlaceholder = document.getElementById('leftNavPlaceholder');
    const collapseIcon = document.getElementById('collapseIcon');
    const expandIcon = document.getElementById('expandIcon');
    const menuLinks = document.querySelectorAll('.menu-link');
    const menuTexts = document.querySelectorAll('.menu-text');
    const groupTitles = document.querySelectorAll('.group-title');
    
    // Check if required DOM elements exist
    if (!toggleBtn || !leftNavbar || !leftNavPlaceholder || !collapseIcon || !expandIcon) {
      console.error('Required DOM elements for navbar not found');
      return;
    }
    
    let isExpanded = true;
    
    // Toggle navbar state function
    function toggleNavbar() {
      isExpanded = !isExpanded;
      
      if (isExpanded) {
        // Expanded state
        (leftNavbar as HTMLElement).style.width = '277px';
        (leftNavPlaceholder as HTMLElement).style.width = '277px';
        if (collapseIcon && expandIcon) {
          collapseIcon.classList.remove('hidden');
          expandIcon.classList.add('hidden');
        }
        
        // Restore menu items to horizontal layout
        menuLinks.forEach(link => {
          link.classList.remove('flex-col', 'items-center', 'text-center');
          link.classList.add('flex-row', 'items-center');
        });
        
        // Show text
        menuTexts.forEach(text => {
          text.classList.remove('hidden');
          (text as HTMLElement).style.marginTop = '0';
        });
        
        // Show group titles
        groupTitles.forEach(title => {
          title.classList.remove('text-center', 'px-1');
          title.classList.add('px-4');
        });
      } else {
        // Collapsed state
        (leftNavbar as HTMLElement).style.width = '80px';
        (leftNavPlaceholder as HTMLElement).style.width = '80px';
        if (collapseIcon && expandIcon) {
          collapseIcon.classList.add('hidden');
          expandIcon.classList.remove('hidden');
        }
        
        // Change menu items to vertical layout
        menuLinks.forEach(link => {
          link.classList.remove('flex-row');
          link.classList.add('flex-col', 'items-center', 'text-center');
        });
        
        // Hide or adjust text
        menuTexts.forEach(text => {
          (text as HTMLElement).style.marginTop = '4px';
          text.classList.add('text-xs');
        });
        
        // Adjust group titles
        groupTitles.forEach(title => {
          title.classList.remove('px-4');
          title.classList.add('text-center', 'px-1', 'text-sm');
        });
      }
    }
    
    // Add click event listener
    toggleBtn.addEventListener('click', toggleNavbar);
  });
</script>

