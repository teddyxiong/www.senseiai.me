      <script>
        // Run after page has loaded
        document.addEventListener('DOMContentLoaded', function() {
          // Get all h2 headings
          const headings: NodeListOf<Element> = document.querySelectorAll('.content h2');
          const tocContainer: HTMLElement | null = document.getElementById('table-of-contents');
          
          // Exit if no TOC container or no h2 headings found
          if (!tocContainer || headings.length === 0) return;
          
          // Create ID for each heading (if not already set)
          headings.forEach((heading, index) => {
            if (!heading.id) {
              heading.id = `heading-${index}`;
            }
          });
          
          // Create table of contents
          const tocList = document.createElement('ul');
          tocList.className = 'toc-list';
          tocList.setAttribute('style', 'list-style-type: none; padding: 0;');
          
          headings.forEach((heading) => {
            const listItem = document.createElement('li');
            listItem.className = 'toc-item';
            listItem.setAttribute('style', 'margin: 8px 0;');
            
            const link = document.createElement('a');
            link.href = `#${heading.id}`;
            link.textContent = heading.textContent || '';
            link.className = 'toc-link';
            link.setAttribute('style', 'color: #393939; text-decoration: none; font-size: 14px; display: block;');
            
            listItem.appendChild(link);
            tocList.appendChild(listItem);
          });
          
          tocContainer.appendChild(tocList);

          // Add scroll listener to highlight current visible heading
          const tocLinks: NodeListOf<Element> = document.querySelectorAll('.toc-link');
          
          function highlightTocOnScroll() {
            // Get positions of all headings
            const headingPositions = Array.from(headings).map(heading => {
              return {
                id: heading.id,
                top: heading.getBoundingClientRect().top
              };
            });
            
            // Find the current visible heading (first one below viewport top)
            let currentHeadingId: string | null = null;
            for (const position of headingPositions) {
              if (position.top > 0 && position.top < window.innerHeight / 2) {
                currentHeadingId = position.id;
                break;
              }
            }
            
            // If no current heading found, use the first heading
            if (!currentHeadingId && headingPositions.length > 0) {
              if (window.scrollY > 0) {
                // Find the last heading above the viewport
                for (let i = headingPositions.length - 1; i >= 0; i--) {
                  if (headingPositions[i].top <= 0) {
                    currentHeadingId = headingPositions[i].id;
                    break;
                  }
                }
              } else if (headingPositions[0]) {
                currentHeadingId = headingPositions[0].id;
              }
            }
            
            // Update TOC link styles
            tocLinks.forEach((link) => {
              if (link instanceof HTMLElement) {
                const href = link.getAttribute('href');
                if (href && href.substring(1) === currentHeadingId) {
                  link.setAttribute('style', 'color: #000; font-weight: bold; display: block; padding: 4px 0; text-decoration: none; font-size: 14px;');
                } else {
                  link.setAttribute('style', 'color: #9ca2ac; font-weight: normal; display: block; padding: 4px 0; text-decoration: none; font-size: 14px;');
                }
              }
            });
          }
          
          // Initialize highlighting
          highlightTocOnScroll();
          
          // Add scroll event listener
          window.addEventListener('scroll', highlightTocOnScroll);
        });
      </script>
