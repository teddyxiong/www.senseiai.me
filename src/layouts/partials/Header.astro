---
import Logo from "@/components/Logo.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import accountMenuConfig from "@/lib/account/menuConfig";
import AccountNav from "@/helpers/AccountNav";
import {
  DEFAULT_LOCALE,
  GLOBAL_ENABLED,
  PUBLISHED_LOCALES,
  buildLocalizedPath,
  getLocaleLabel,
  resolveLocaleFromPath,
} from "@/lib/i18n/config";

export interface ChildNavigationLink {
  name: string;
  description?: string;
  url: string;
}

export interface NavigationLink {
  name: string;
  url: string;
  hasChildren?: boolean;
  children?: ChildNavigationLink[];
}

export interface Props {
  currentLocale?: string;
  currentLocaleLabel?: string;
  variant?: string;
}

const { main }: { main: NavigationLink[] } = menu;
const { navigation_button, settings } = config;
const { banner_enable, banner_title, promo_code, banner_ad_url, banner_img, banner_bgimg } = config.site;
const { pathname } = Astro.url;
const { currentLocale: inputLocale, currentLocaleLabel: inputLocaleLabel, variant } = Astro.props as Props;
const currentLocale = inputLocale || resolveLocaleFromPath(pathname);
const currentLocaleLabel = inputLocaleLabel || getLocaleLabel(currentLocale);
const englishFallbackPath = buildLocalizedPath(pathname, DEFAULT_LOCALE);
const showLocalePackageNav =
  GLOBAL_ENABLED &&
  PUBLISHED_LOCALES.some((locale) => locale !== "en") &&
  variant !== "no-locale";
---

<header
  class={`header z-30 ${settings.sticky_header && "sticky top-0"}`}
  data-current-locale={currentLocale}
  data-current-locale-label={currentLocaleLabel}
  data-default-locale={DEFAULT_LOCALE}
>
  {banner_enable && (
    <div class="w-full h-[80px] flex justify-center items-center bg-no-repeat bg-cover bg-center relative z-40" style={`background-image: url('${banner_bgimg}');`}>
      <div class="container mx-auto px-4">
        <div class="flex justify-center items-center h-full">
          <a href="#" id="couponBanner" data-url={banner_ad_url} data-code={promo_code}>
            <img src={banner_img} alt={banner_title} class="h-auto max-h-[80px] object-contain"></a>
        </div>
      </div>
    </div>
  )}
  <div class="bg-transparent">
    <div class="w-full px-4 sm:px-6 md:px-10 lg:px-20">
      {variant === "payment-success" ? (
        <nav class="navbar relative justify-between">
          <!-- logo -->
          <div class="order-0 shrink-0">
            <Logo src="/images/logo-blue.webp" />
          </div>
          <!-- centered home link -->
          <ul class="navbar-nav flex" style="position:absolute;left:50%;top:auto;right:auto;bottom:auto;width:auto;min-height:auto;padding:0;overflow:visible;background:transparent;box-shadow:none;opacity:1;visibility:visible;pointer-events:auto;transform:translateX(-50%);">
            <li class="nav-item" style="width:auto;border-bottom:0;">
              <a href="/" class="nav-link" style="width:auto;">Home</a>
            </li>
          </ul>
          <!-- account nav -->
          <div class="order-0 ml-auto shrink-0">
            {/* Temporarily hidden: account login */}
            {false && (
              <AccountNav
                client:idle
                transition:name="account-nav-payment-success"
                transition:persist
                menuConfig={accountMenuConfig}
              />
            )}
          </div>
        </nav>
      ) : (
        <nav class="navbar">
          <!-- logo -->
          <div class="navbar-logo order-0 shrink-0">
            <Logo src="/images/logo-blue.webp" />
          </div>

        <div class="mobile-header-actions order-1 ml-auto flex items-center gap-2">
          {/* Temporarily hidden: language switcher */}
          {false && showLocalePackageNav && (
            <div class="mobile-header-locale group relative locale-system-font">
              <button
                type="button"
                class="inline-flex h-[32px] items-center gap-1 rounded-md border border-border bg-white px-2 py-1 text-sm font-bold text-primary transition hover:border-primary hover:text-primary"
                aria-label="Language Package"
              >
                <img
                  src="/images/icons/globe-language.svg"
                  alt=""
                  class="h-4 w-4"
                  width="16"
                  height="16"
                  loading="lazy"
                  decoding="async"
                />
                {/* <span>{currentLocaleLabel}</span> */}
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M7 10l5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </button>
              <ul class="menu-dropdown-panel invisible absolute right-0 z-50 mt-2 grid min-w-[230px] grid-cols-2 translate-y-2 opacity-0 transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                {PUBLISHED_LOCALES.map((locale) => (
                  <li>
                    <a
                      href={buildLocalizedPath(pathname, locale)}
                      data-fallback-href={englishFallbackPath}
                      data-locale={locale}
                      class:list={[
                        "menu-dropdown-link js-locale-switch-link",
                        locale === currentLocale
                          ? "locale-current"
                          : "",
                      ]}
                    >
                      {getLocaleLabel(locale)}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {/* Temporarily hidden: account login */}
          {false && (
            <AccountNav
              client:idle
              transition:name="account-nav-mobile"
              transition:persist
              menuConfig={accountMenuConfig}
            />
          )}

          <!-- navbar toggler -->
          <button
            class="navbar-toggler group relative shrink-0"
            aria-label="Open navigation menu"
            aria-controls="nav-menu"
            aria-expanded="false"
          >
            <div
              class="relative flex h-[30px] w-[30px] transform items-center justify-center overflow-hidden rounded-full ring-0 transition-all duration-200"
            >
              <div
                class="flex h-[15px] w-[18px] origin-center transform flex-col justify-between overflow-hidden transition-all duration-300 group-[.active]:h-[21px]"
              >
                <div
                  class="h-[2px] w-7 origin-left transform bg-dark transition-all duration-300 group-[.active]:translate-x-10"
                >
                </div>
                <div
                  class="h-[2px] w-7 transform rounded bg-dark transition-all delay-75 duration-300 group-[.active]:translate-x-10"
                >
                </div>
                <div
                  class="h-[2px] w-7 origin-left transform bg-dark transition-all delay-150 duration-300 group-[.active]:translate-x-10"
                >
                </div>
                <div
                  class="absolute top-2.5 flex w-0 -translate-x-10 transform items-center justify-between transition-all duration-500 group-[.active]:w-12 group-[.active]:translate-x-0"
                >
                  <div
                    class="absolute h-[2px] w-5 rotate-0 transform bg-dark transition-all delay-300 duration-500 group-[.active]:rotate-45"
                  >
                  </div>
                  <div
                    class="absolute h-[2px] w-5 -rotate-0 transform bg-dark transition-all delay-300 duration-500 group-[.active]:-rotate-45"
                  >
                  </div>
                </div>
              </div>
            </div>
          </button>
          <!-- /navbar toggler -->
        </div>

        <ul
          id="nav-menu"
          class="navbar-nav order-3 hidden w-full"
        >
          {
            main.map((menu) => (
              <>
                {menu.hasChildren ? (
                  <li class="nav-item nav-dropdown group relative">
                    <span
                      role="button"
                      tabindex="0"
                      aria-expanded="false"
                      class={`nav-link dropdown-toggle inline-flex items-center ${
                        menu.children?.map(({ url }) => url).includes(pathname) ||
                        menu.children
                          ?.map(({ url }) => `${url}/`)
                          .includes(pathname)
                          ? "active"
                          : ""
                      }`}
                    >
                      {menu.name}
                      <svg class="h-4 w-4 arrow-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M7 10l5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                    </span>
                    <ul class="nav-dropdown-list menu-dropdown-panel invisible absolute flex translate-y-2 flex-col opacity-0 transition-all duration-300 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                      {menu.children?.map((child) => (
                        <li class="nav-dropdown-item">
                          <a
                            href={child.url}
                            aria-label={child.name}
                            class={`nav-dropdown-link menu-dropdown-link w-full text-left ${
                              (pathname === `${child.url}/` ||
                                pathname === child.url) &&
                              "active"
                            }`}
                          >
                            {child.description ? (
                              <>
                                <span class="nav-dropdown-title">{child.name}</span>
                                <span class="nav-dropdown-description">{child.description}</span>
                              </>
                            ) : (
                              child.name
                            )}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </li>
                ) : (
                  <li class="nav-item">
                    <a
                      href={menu.url}
                      class={`nav-link ${
                        (pathname === `${menu.url}/` || pathname === menu.url) &&
                        "active"
                      }`}
                    >
                      {menu.name}
                    </a>
                  </li>
                )}
              </>
            ))
          }
          {
            /* Temporarily hidden: Download Now */
            false && navigation_button.enable && (
              <li class="mobile-menu-cta">
                <a class="btn btn-header-primary w-full" href={navigation_button.link}>
                  {navigation_button.label}
                </a>
              </li>
            )
          }
        </ul>

        <div class="desktop-header-actions order-1 ml-auto hidden shrink-0 items-center gap-3">
          {
            /* Temporarily hidden: language switcher */
            false && showLocalePackageNav && (
              <div class="group relative locale-system-font">
                <button
                  type="button"
                  class="inline-flex h-[35px] items-center gap-1 rounded-md border border-border bg-white px-2 py-1 text-sm font-bold text-primary transition hover:border-primary hover:text-primary"
                  aria-label="Language Package"
                >
                  <img
                    src="/images/icons/globe-language.svg"
                    alt=""
                    class="h-4 w-4"
                    width="16"
                    height="16"
                    loading="lazy"
                    decoding="async"
                  />
                  {/* <span>{currentLocaleLabel}</span> */}
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M7 10l5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </button>
                <ul class="menu-dropdown-panel invisible absolute right-0 z-50 mt-2 grid min-w-[230px] grid-cols-2 translate-y-2 opacity-0 transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                  {PUBLISHED_LOCALES.map((locale) => (
                    <li>
                      <a
                        href={buildLocalizedPath(pathname, locale)}
                        data-fallback-href={englishFallbackPath}
                        data-locale={locale}
                        class:list={[
                          "menu-dropdown-link js-locale-switch-link",
                          locale === currentLocale
                            ? "locale-current"
                            : "",
                        ]}
                      >
                        {getLocaleLabel(locale)}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
          {/* <AccountNav
            client:idle
            transition:name="account-nav-desktop"
            transition:persist
            menuConfig={accountMenuConfig}
          /> */}
          {/* Temporarily hidden: Download Now */}
          {false && navigation_button.enable && (
            <a class="btn btn-header-primary" href={navigation_button.link}>
              {navigation_button.label}
            </a>
          )}
        </div>
      </nav>
      )}
    </div>
  </div>
</header>

<script>
  import { writeLocalePreference } from "@/lib/i18n/localePreference";
  document.addEventListener("astro:page-load", () => {
    const w = window as unknown as {
      __headerAbortController?: AbortController;
    };
    w.__headerAbortController?.abort();
    w.__headerAbortController = new AbortController();
    const { signal } = w.__headerAbortController;

    const header = document.querySelector(".header") as HTMLElement | null;
    const compactLayout = window.matchMedia("(max-width: 767px)");
    const navbarToggler = document.querySelector(
      ".navbar-toggler"
    ) as HTMLButtonElement | null;
    const navbarMenu = document.querySelector(".navbar-nav") as HTMLElement | null;

    // Astro view transitions can preserve menu state between pages, so reset it.
    document.body.classList.remove("mobile-nav-open");
    header?.classList.remove("mobile-menu-open");
    navbarToggler?.classList.remove("active");
    navbarMenu?.classList.remove("active");
    navbarToggler?.setAttribute("aria-expanded", "false");

    const setMobileMenuTop = () => {
      if (!header || !navbarMenu || !compactLayout.matches) return;
      const headerBottom = Math.max(0, header.getBoundingClientRect().bottom);
      navbarMenu.style.setProperty("--mobile-nav-top", `${headerBottom}px`);
    };

    const setMenuOpen = (open: boolean) => {
      navbarToggler?.classList.toggle("active", open);
      navbarMenu?.classList.toggle("active", open);
      header?.classList.toggle("mobile-menu-open", open);
      document.body.classList.toggle("mobile-nav-open", open);
      navbarToggler?.setAttribute("aria-expanded", String(open));
      navbarToggler?.setAttribute(
        "aria-label",
        open ? "Close navigation menu" : "Open navigation menu"
      );

      if (open) setMobileMenuTop();
    };

    const handleLayoutChange = () => {
      if (!compactLayout.matches) {
        setMenuOpen(false);
        navbarMenu?.style.removeProperty("--mobile-nav-top");
      } else if (navbarMenu?.classList.contains("active")) {
        setMobileMenuTop();
      }
    };

    navbarToggler?.addEventListener(
      "click",
      () => {
        setMenuOpen(!navbarMenu?.classList.contains("active"));
      },
      { signal }
    );

    compactLayout.addEventListener("change", handleLayoutChange, { signal });

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape" && navbarMenu?.classList.contains("active")) {
          setMenuOpen(false);
          navbarToggler?.focus();
        }
      },
      { signal }
    );

    const onScroll = () => {
      if (!header) return;
      if (window.scrollY > 0) header.classList.add("header-fixed-top");
      else header.classList.remove("header-fixed-top");
    };
    window.addEventListener("scroll", onScroll, { signal });
    onScroll();

    const dropdownMenuToggler = document.querySelectorAll(
      ".nav-dropdown > .nav-link"
    ) as NodeListOf<HTMLElement>;

    const toggleDropdown = (toggler: HTMLElement) => {
      if (!compactLayout.matches) return;

      const parent = toggler.parentElement;
      const willOpen = !parent?.classList.contains("active");

      // Keep the mobile menu visually tidy by opening only one accordion at a time.
      navbarMenu?.querySelectorAll(".nav-dropdown.active").forEach((dropdown) => {
        if (dropdown !== parent) {
          dropdown.classList.remove("active");
          dropdown
            .querySelector(":scope > .nav-link")
            ?.setAttribute("aria-expanded", "false");
        }
      });

      parent?.classList.toggle("active", willOpen);
      toggler.setAttribute("aria-expanded", String(willOpen));
    };

    dropdownMenuToggler.forEach((toggler) => {
      if (!toggler.hasAttribute("aria-expanded")) {
        toggler.setAttribute("aria-expanded", "false");
      }

      toggler.addEventListener("click", () => toggleDropdown(toggler), { signal });
      toggler.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            toggleDropdown(toggler);
          }
        },
        { signal }
      );
    });

    navbarMenu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenuOpen(false), { signal });
    });

    const localeSwitchLinks = document.querySelectorAll(
      ".js-locale-switch-link"
    ) as NodeListOf<HTMLAnchorElement>;

    const shouldSkipLocaleIntercept = (e: MouseEvent, link: HTMLAnchorElement) =>
      e.defaultPrevented ||
      e.button !== 0 ||
      e.metaKey ||
      e.ctrlKey ||
      e.shiftKey ||
      e.altKey ||
      link.target === "_blank";

    localeSwitchLinks.forEach((link) => {
      link.addEventListener(
        "click",
        async (e) => {
          if (shouldSkipLocaleIntercept(e, link)) return;

          const targetHref = link.getAttribute("href");
          const fallbackHref = link.dataset.fallbackHref;
          const targetLocale = link.dataset.locale;
          const defaultLocale = header?.dataset.defaultLocale;
          if (!targetHref || !fallbackHref) return;

          const targetUrl = new URL(targetHref, window.location.origin);
          const fallbackUrl = new URL(fallbackHref, window.location.origin);
          if (targetUrl.pathname === window.location.pathname) {
            if (targetLocale) writeLocalePreference(targetLocale);
            return;
          }

          e.preventDefault();

          try {
            const probe = await fetch(targetUrl.toString(), {
              method: "HEAD",
              cache: "no-store",
              redirect: "follow",
            });
            if (probe.ok) {
              if (targetLocale) writeLocalePreference(targetLocale);
              window.location.href = targetUrl.toString();
              return;
            }
          } catch (err) {
            console.warn("Locale target probe failed, fallback to English page.", err);
          }

          if (defaultLocale) writeLocalePreference(defaultLocale);
          window.location.href = fallbackUrl.toString();
        },
        { signal }
      );
    });

    const couponBanner = document.getElementById("couponBanner");
    if (couponBanner) {
      const copyToClipboard = async (text: string) => {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          try {
            await navigator.clipboard.writeText(text);
            return true;
          } catch (err) {
            console.error("Clipboard API failed:", err);
          }
        }

        try {
          const textArea = document.createElement("textarea");
          textArea.value = text;
          textArea.style.position = "fixed";
          textArea.style.left = "-999999px";
          textArea.style.top = "-999999px";
          document.body.appendChild(textArea);
          textArea.focus();
          textArea.select();

          const successful = document.execCommand("copy");
          document.body.removeChild(textArea);
          return successful;
        } catch (err) {
          console.error("Fallback copy method failed:", err);
          return false;
        }
      };

      couponBanner.addEventListener(
        "click",
        (e) => {
          e.preventDefault();

          const currentElement = e.currentTarget as HTMLElement;
          const targetUrl = currentElement.getAttribute("data-url");
          const promoCode =
            currentElement.getAttribute("data-code") || "Sensei20";

          copyToClipboard(promoCode).then((success) => {
            const message = success
              ? `The discount code "${promoCode}"  has been copied！\nYou can apply it to any membership plan.\n\nClick "OK" to upgrade to Sensei AI Membership `
              : `Please manually copy the promo code: ${promoCode}\n\nClick "OK" to upgrade to Sensei AI Membership`;

            if (confirm(message)) {
              if (targetUrl) window.open(targetUrl, "_blank");
              else console.error("Target URL is not defined");
            }
          });
        },
        { signal }
      );
    }
  });
</script>

<style lang="scss">
  .locale-system-font {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
      "Hiragino Sans GB", "Microsoft YaHei", Arial, sans-serif;
  }

  :global(body.mobile-nav-open) {
    overflow: hidden;
    overscroll-behavior: none;
  }

  @media (min-width: 768px) {
    .navbar .mobile-header-actions {
      display: none;
    }

    .navbar .navbar-nav {
      order: 1;
      position: absolute;
      left: 50%;
      display: flex;
      width: auto;
      transform: translateX(-50%);
      justify-content: center;
      gap: 0.5rem;
    }

    .navbar .mobile-menu-cta {
      display: none;
    }

    .navbar .desktop-header-actions {
      order: 2;
      display: flex;
      margin-left: 0;
    }
  }

  @media (max-width: 767px) {
    .navbar {
    .navbar-toggler {
      z-index: 70;
      display: inline-flex;
      min-height: 44px;
      min-width: 44px;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(15, 23, 42, 0.1);
      border-radius: 10px;
      background: var(--navbar-glass-bg, rgba(255, 255, 255, 0.94));
      -webkit-backdrop-filter: var(--navbar-glass-blur, blur(14px) saturate(140%));
      backdrop-filter: var(--navbar-glass-blur, blur(14px) saturate(140%));
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
    }

    .navbar-nav {
      position: fixed;
      top: var(--mobile-nav-top, 72px);
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 60;
      display: flex !important;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      min-height: 0;
      padding: 14px 20px calc(18px + env(safe-area-inset-bottom));
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--navbar-glass-bg, rgba(255, 255, 255, 0.94));
      -webkit-backdrop-filter: var(--navbar-glass-blur, blur(14px) saturate(140%));
      backdrop-filter: var(--navbar-glass-blur, blur(14px) saturate(140%));
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateX(24px);
      transition:
        opacity 180ms ease,
        transform 220ms ease,
        visibility 220ms ease;
    }

    .navbar-nav:not(.active) {
      transition: none;
    }

    .navbar-nav.active {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateX(0);
    }

    .navbar-nav > .nav-item {
      width: 100%;
      border-bottom: 1px solid rgba(15, 23, 42, 0.07);
    }

    .navbar-nav > .nav-item > .nav-link {
      display: flex;
      width: 100%;
      min-height: 54px;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 4px;
      color: #142b72;
      font-size: 17px;
      font-weight: 600;
      line-height: 1.35;
      text-align: left;
      cursor: pointer;
    }

    .navbar-nav > .nav-item > .nav-link::after {
      display: none !important;
    }

    .navbar-nav > .nav-item > .nav-link.active {
      color: #286fd6;
    }

    .nav-dropdown .arrow-icon {
      flex: 0 0 auto;
      transition: transform 180ms ease;
    }

    .nav-dropdown.active > .nav-link .arrow-icon {
      transform: rotate(180deg);
    }

    .nav-dropdown-list {
      position: static !important;
      display: none !important;
      width: 100%;
      margin: 0 0 12px;
      padding: 6px;
      border: 0;
      border-radius: 12px;
      box-shadow: none !important;
      opacity: 1 !important;
      visibility: visible !important;
      transform: none !important;
    }

    .nav-dropdown.active > .nav-dropdown-list {
      display: block !important;
    }

    .nav-dropdown-item + .nav-dropdown-item {
      margin-top: 2px;
    }

    .nav-dropdown-link {
      display: block;
      width: 100%;
      padding: 12px 14px;
      border-radius: 9px;
      color: #475569;
      font-size: 15px;
      font-weight: 500;
      line-height: 1.4;
      text-align: left;
      transition:
        color 150ms ease,
        background-color 150ms ease;
    }

    .nav-dropdown-link:hover,
    .nav-dropdown-link:focus-visible,
    .nav-dropdown-link.active {
      color: #142b72;
      background: #ffffff;
    }

    .mobile-menu-cta {
      width: 100%;
      margin-top: 12px;
      padding-top: 0;
      list-style: none;
    }

    .mobile-menu-cta .btn {
      display: inline-flex;
      min-height: 52px;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      font-size: 17px;
      font-weight: 700;
    }
    }
  }


</style>
