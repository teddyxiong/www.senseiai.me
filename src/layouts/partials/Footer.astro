---
import Social from "@/components/Social.astro";
import VideoModal from "@/components/VideoModal.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import social from "@/config/social.json";
import { SIGN_IN_URL } from "@/lib/account/constants";
import { markdownify } from "@/lib/utils/textConverter";

const { copyright, phone, email } = config.params;
const { footer, quickLinks, Alternatives: alternatives, "Undetectable Help": undetectableHelp, Reviews: reviews, "Use Cases": useCases } = menu;
const { variant = "default" } = Astro.props as { variant?: "default" | "home" };
---

<footer class={`footer bg-theme-dark`}>
  <div class="w-full px-4 sm:px-6 md:px-10 lg:px-20" data-aos="fade-in">
    <div class="row gy-2 mt-0 justify-between pt-10 pb-5 lg:gy-2 items-center">
      <div class="col-12 lg:col-3">
        <img
          class="mb-6 lg:mb-0"
          width="167"
          height="70"
          src="/images/linkjob-logo.png"
          alt="linkjob-logo"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="col-12 lg:col-9">
        <p>
          senseiai.me - 100% invisible AI interview assistant during live interviews and coding assessments. Get instant AI assistance for interview questions or online problem-solving.
        </p>
        <Social source={social?.main} className="social-icons" />
      </div>
    </div>

    <div class="row gy-4 mt-0 pb-10 pt-5 lg:gy-4">
      <div class="sm:col-4 md:col-3 lg:col-2">
        <h3 class="h6 mb-6 font-semibold text-white">About Us</h3>
        <ul class="text-[15px] footer-linklist flex flex-col gap-2 [&>li>a:hover]:text-white">
          {
            footer.map((item) => (
              <li>
                <a
                  href={item.url}
                  data-manage-subscription={item.url === SIGN_IN_URL ? "" : undefined}
                >
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="sm:col-4 md:col-3 lg:col-2">
        <h3 class="h6 mb-6 font-semibold text-white">AI Interview Assistant</h3>
        <ul class="text-[15px] footer-linklist flex flex-col gap-2 [&>li>a:hover]:text-white">
          {
            quickLinks.map((item) => (
              <li>
                <a href={item.url}>{item.name}</a>
              </li>
            ))
          }
        </ul>
      </div>
      
      <div class="sm:col-4 md:col-3 lg:col-2">
        <h3 class="h6 mb-6 font-semibold text-white">Comparison</h3>
        <ul class="text-[15px] footer-linklist flex flex-col gap-2 [&>li>a:hover]:text-white">
          {
            alternatives?.map((item) => (
              <li>
                <a href={item.url}>{item.name}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="sm:col-4 md:col-3 lg:col-2">
        <h3 class="h6 mb-6 font-semibold text-white">Real-Time Support</h3>
        <ul class="text-[15px] footer-linklist flex flex-col gap-2 [&>li>a:hover]:text-white">
          {
            undetectableHelp?.map((item) => (
              <li>
                <a href={item.url}>{item.name}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="sm:col-4 md:col-3 lg:col-2">
        <h3 class="h6 mb-6 font-semibold text-white">Reviews</h3>
        <ul class="text-[15px] footer-linklist flex flex-col gap-2 [&>li>a:hover]:text-white">
          {
            reviews?.map((item) => (
              <li>
                <a href={item.url}>{item.name}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="sm:col-4 md:col-3 lg:col-2">
        <h3 class="h6 mb-6 font-semibold text-white">Use Cases</h3>
        <ul class="text-[15px] footer-linklist flex flex-col gap-2 [&>li>a:hover]:text-white">
          {
            useCases?.map((item) => (
              <li>
                <a href={item.url}>{item.name}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- <div class="sm:col-4 md:col-4 lg:col-auto">
        <h3 class="h5 mb-6 font-medium text-white">Our Locations</h3>
        <ul class="flex flex-col gap-3 [&>li>a:hover]:text-white">
          <li><a href="#">USA - Headquarters</a></li>
          <li><a href="#">Canada</a></li>
          <li><a href="#">Europe</a></li>
          <li><a href="#">India</a></li>
        </ul>
      </div> -->
      <!-- <div class="sm:col-4 md:col-7 lg:col-auto">
        <h3 class="h5 mb-6 font-medium text-white">Contact us</h3>
        <ul class="flex flex-col gap-3 [&>li>a:hover]:text-white">
          <li>
            WhatsApp:
            <br />
            <a href={`tel:${phone}`} set:html={markdownify(phone)} />
          </li>
          <li>
            Email:
            <br />
            <a href={`mailto:${email}`} set:html={markdownify(email)} />
          </li>
        </ul>
      </div> -->
    </div>

    <!-- Copyright Text -->
    <div
      class="gradient gradient-horizontal gradient-to-center py-7 after:top-0 after:via-white/20"
    >
      <!-- Copyright and Badge Images in same row -->
      <div class="flex justify-center items-center">
        <div
          class="text-light/70 text-center has-[link]:underline"
          set:html={markdownify(copyright)}
        />
        <!-- <div class="flex items-center gap-4">
          <div class="flex gap-2">
            
            <a href="https://www.producthunt.com/products/linkjob-ai/launches" target="_blank">
              <img src="/images/hdpd.png" width="120" alt="Product Hunt badge" />
            </a>
            <a href="https://climate.stripe.com/bMwqvc" target="_blank"><img src="/images/hdstripe.png" width=120 alt="stripe and senseiai.me" /></a>
          </div>
        </div> -->
      </div>
    </div>
    <!-- <div
      class="gradient gradient-horizontal gradient-to-center py-7 after:top-0 after:via-white/20"
    >
      <div
        class="text-light/70 md:text-center has-[link]:underline"
        set:html={markdownify(copyright)}
      />
    </div> -->
  </div>
</footer>

<style is:global>
  .footer .social-icons li a:hover {
    color: #253b80 !important;
  }

  .footer .social-icons li a:hover svg,
  .footer .social-icons li a:hover svg * {
    fill: #253b80 !important;
    stroke: #253b80 !important;
  }

  .footer .footer-linklist > li > a:hover {
    color: #4F8FEF !important;
  }
</style>

<VideoModal />
