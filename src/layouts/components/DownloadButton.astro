---
const { href, label, fileSize, sizeLabel, icon }: {
  href?: string;
  label?: string;
  fileSize?: string;
  sizeLabel?: string;
  icon?: string;
} = Astro.props;
---

<a
  href={href}
  class="download-btn flex min-h-[44px] w-full items-center justify-between rounded-xl border border-[#27458D] px-4 text-[#27458D] transition-colors hover:bg-[#F5F8FF]"
  download
>
  <span class="flex items-center gap-3 text-sm font-semibold">
    {icon && (
      <img
        src={icon}
        alt=""
        aria-hidden="true"
        class="h-5 w-5 object-contain"
      />
    )}
    {label}
  </span>

  <span class="flex items-center gap-3 text-xs text-gray-500">
    <span class="h-5 w-px bg-gray-300"></span>
    <span>
      {sizeLabel} {fileSize}
    </span>
  </span>
</a>
