---
interface Platform {
  id: string;
  name: string;
  icon: string; // path under public, e.g. /images/brands/zoom-logo.png
  status: 'Undetectable' | 'supported' | 'beta' | 'planned' | 'unsupported' | 'unknown' | 'tested';
  url?: string;
  notes?: string;
  video?: string;
}

// Allow external data via props, fallback to default JSON config
import defaultPlatforms from '../../config/platforms-interview-copilot.json';
const rawPlatforms: Platform[] = (Astro.props.platforms ?? defaultPlatforms) as Platform[];
const fallbackVideo = "https://www.youtube.com/embed/GRlpVJAoPuc?si=CDRpo3Yz9jkxjZmV";
const normalizeStatus = (value: unknown): Platform['status'] => {
  const raw = String(value ?? "").trim();
  const lower = raw.toLowerCase();
  if (lower === "undetectable") return "Undetectable";
  if (lower === "supported") return "supported";
  if (lower === "beta") return "beta";
  if (lower === "planned") return "planned";
  if (lower === "unsupported") return "unsupported";
  if (lower === "tested") return "tested";
  return "unknown";
};

const platforms: Platform[] = rawPlatforms.map((p) => ({
  ...p,
  status: normalizeStatus(p.status),
  video: (p.video && p.video.trim() !== '' ? p.video : fallbackVideo),
}));

// Compute current month/year on the client for the default "Last verified" value
const now = new Date();
const yesterday = new Date(now);
yesterday.setDate(now.getDate() - 1);
const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const lastVerified = `${monthNames[yesterday.getMonth()]}  ${yesterday.getFullYear()}`;

const statusMap: Record<Platform['status'], { label: string; className: string }> = {
  Undetectable: { label: 'Undetectable', className: 'bg-green-100 text-green-700' },
  supported: { label: 'Supported', className: 'bg-green-100 text-green-700' },
  beta: { label: 'Beta', className: 'bg-yellow-100 text-yellow-700' },
  planned: { label: 'planned', className: 'bg-blue-100 text-blue-700' },
  unsupported: { label: 'unsupported', className: 'bg-gray-100 text-gray-600' },
  unknown: { label: 'unknown', className: 'bg-gray-100 text-gray-600' },
  tested: { label: 'tested', className: 'bg-green-100 text-green-700' },
};
---

<section aria-labelledby="platforms-title" class="container mx-auto px-4 bg-white">
  <h3 id="platforms-title" class="sr-only">Works Across Major Interview Platforms</h3>
  <div class="max-w-6xl mx-auto">
    <ul class="rounded-lg space-y-3">
      {platforms.map((p) => (
        <li class="flex flex-col gap-3 rounded-md border border-[#e5e5e5] bg-[#fbfbfa] p-4">
          <div class="flex flex-col gap-3 lg:relative lg:flex-row lg:items-center">
            <div class="flex items-center gap-3">
              <img src={p.icon} alt={p.name} class="h-12 w-12 object-contain" loading="lazy" />
              <span class="text-sm font-medium text-gray-900">{p.name}</span>
            </div>

            <div class="w-full text-left lg:absolute lg:left-[52%] lg:w-[520px] lg:max-w-[50%] lg:-translate-x-1/2">
              <button
                type="button"
                class="inline-flex w-full items-center justify-start text-sm font-medium text-gray-900"
                data-video-toggle
                data-platform-id={p.id}
                data-video={p.video}
              >
                <span class="min-w-0">
                  Watch how Interview Copilot works on
                  {/* <span class="hidden sm:inline"> on</span> */}
                </span>
                <span class="ml-1 hidden text-green-600 text-base sm:inline">{p.name}</span>
                <span class="ml-2 inline-flex items-center justify-center rounded-full border border-gray-300 px-2 py-0.5 text-[11px] leading-none text-gray-600 self-start sm:self-center">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M9 7v10l9-5-9-5z" fill="currentColor"></path>
                  </svg>
                </span>
              </button>
            </div>

            <div class="flex w-full flex-wrap items-center justify-between gap-2 lg:ml-auto lg:w-auto lg:justify-end">
              <span
                class={`inline-block rounded px-2 py-0.5 text-xs ${statusMap[p.status]?.className}`}
                data-status-label={p.status}
              ></span>
              <span class="text-xs text-gray-500 sm:whitespace-nowrap last-verified-text">{lastVerified}</span>
            </div>
          </div>
          <div class="hidden w-full" data-video-wrapper data-platform-id={p.id}></div>
        </li>
      ))}
    </ul>
  </div>
  <slot />
  <!-- Usage example (not included in existing pages):
    <PlatformStatusList platforms={[
      { id: 'zoom', name: 'Zoom', icon: '/images/brands/zoom-logo.png', status: 'Undetectable' }
    ]} />
  -->
</section>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement | null;
    const button = target?.closest("[data-video-toggle]") as HTMLElement | null;
    if (!button) return;
    const list = button.closest("ul");
    if (!list) return;
    const platformId = button.getAttribute("data-platform-id") || "";
    const video = button.getAttribute("data-video") || "";
    const wrappers = Array.from(list.querySelectorAll("[data-video-wrapper]")) as HTMLElement[];
    wrappers.forEach((wrapper) => {
      const id = wrapper.getAttribute("data-platform-id") || "";
      if (id !== platformId) {
        wrapper.classList.add("hidden");
        wrapper.innerHTML = "";
        wrapper.setAttribute("data-open", "false");
      }
    });
    const current = wrappers.find((wrapper) => wrapper.getAttribute("data-platform-id") === platformId);
    if (!current) return;
    const isOpen = current.getAttribute("data-open") === "true";
    if (isOpen) {
      current.classList.add("hidden");
      current.innerHTML = "";
      current.setAttribute("data-open", "false");
      return;
    }
    current.innerHTML = `
      <div class="mt-3 relative w-full overflow-hidden rounded-md bg-black/5 pb-[62%] sm:pb-[56.25%]">
        <iframe class="absolute left-0 top-0 h-full w-full" src="${video}" title="video" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
      </div>
    `;
    current.classList.remove("hidden");
    current.setAttribute("data-open", "true");
  });
</script>

<style>
  /* Status Labels */
  [data-status-label="Undetectable"]::after {
    content: "Undetectable";
  }
  [data-status-label="supported"]::after {
    content: "Supported";
  }
  [data-status-label="beta"]::after {
    content: "Beta";
  }
  [data-status-label="planned"]::after {
    content: "Planned";
  }
  [data-status-label="unsupported"]::after {
    content: "Unsupported";
  }
  [data-status-label="unknown"]::after {
    content: "Unknown";
  }
  [data-status-label="tested"]::after {
    content: "Tested";
  }

  /* Last tested Prefix */
  .last-verified-text::before {
    content: "Last tested: ";
  }
</style>
